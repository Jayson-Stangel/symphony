#!/usr/bin/env bash
# Portable project bootstrapper for a local Symphony installation.
set -euo pipefail

die() { printf 'symphony-project: %s\n' "$*" >&2; exit 1; }

script_path=${BASH_SOURCE[0]}
while [ -L "$script_path" ]; do
  link=$(readlink "$script_path")
  case "$link" in
    /*) script_path=$link ;;
    *) script_path=$(cd "$(dirname "$script_path")" && cd "$(dirname "$link")" && pwd)/$(basename "$link") ;;
  esac
done
script_dir=$(cd "$(dirname "$script_path")" && pwd)
symphony_home=${SYMPHONY_HOME:-$(cd "$script_dir/.." && pwd)}
config_home=${SYMPHONY_CONFIG_HOME:-"${XDG_CONFIG_HOME:-$HOME/.config}/symphony"}
bin_dir=${SYMPHONY_BIN_DIR:-"$HOME/.local/bin"}

ensure_launcher_link() {
  local source=$1 target=$2
  source=$(cd "$(dirname "$source")" && pwd)/$(basename "$source")
  mkdir -p "$(dirname "$target")"

  if [ -L "$target" ]; then
    [ "$(readlink "$target")" = "$source" ] || die "refusing to replace existing symlink: $target"
    printf 'Preserving launcher link: %s\n' "$target"
    return
  fi
  [ ! -e "$target" ] || die "refusing to replace existing path: $target"
  ln -s "$source" "$target"
  printf 'Created launcher link: %s\n' "$target"
}

required_tools() {
  local tool missing=0
  for tool in git mise gh codex; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      printf 'Missing prerequisite: %s\n' "$tool" >&2
      missing=1
    fi
  done
  return "$missing"
}

install_prerequisites() {
  case "$(uname -s)" in
    Darwin)
      command -v git >/dev/null 2>&1 || {
        xcode-select --install || true
        die 'install the Xcode Command Line Tools, then rerun this command'
      }
      command -v brew >/dev/null 2>&1 || die 'install Homebrew first: https://brew.sh'
      command -v mise >/dev/null 2>&1 || brew install mise
      command -v gh >/dev/null 2>&1 || brew install gh
      if ! command -v codex >/dev/null 2>&1; then
        command -v npm >/dev/null 2>&1 || brew install node
        npm install -g @openai/codex@latest
      fi
      ;;
    *)
      die 'automatic prerequisite installation currently supports macOS only; install git, mise, gh, and Codex, then rerun install'
      ;;
  esac
}

install_runtime() {
  mise -C "$symphony_home/elixir" install
}

repo_root() { git rev-parse --show-toplevel 2>/dev/null || die 'run this command inside a Git repository'; }

project_id() {
  local remote name
  remote=$(git -C "$1" remote get-url origin 2>/dev/null || true)
  name=$(basename "${remote:-$1}" .git | tr -cs '[:alnum:]._' '-' | sed 's/-*$//')
  printf '%s\n' "$name"
}

usage() {
  cat <<'EOF'
Usage:
  symphony-project install [--install-prerequisites]
  symphony-project update
  symphony-project doctor
  symphony-project init --linear-project <slug>
  symphony-project run [--port <port>]

Install and update are intended for a clean, stable Symphony checkout, such as
~/src/symphony. `install` links this command into $SYMPHONY_BIN_DIR (default:
~/.local/bin), creates $SYMPHONY_CONFIG_HOME (default: ~/.config/symphony),
and installs the Erlang/Elixir runtime declared by this checkout. It never
overwrites an existing command, credentials, or project workflow.

Use --install-prerequisites to install missing mise, gh, and Codex on macOS.
Git is supplied by the Xcode Command Line Tools and may require a separate
interactive confirmation. `doctor` only reports readiness and changes nothing.

Set SYMPHONY_HOME when this script is copied outside the Symphony checkout.
Set SYMPHONY_BIN_DIR and SYMPHONY_CONFIG_HOME to use alternate locations.

Credentials created by init:
  The generated per-project .env file is stored outside the repository at:
    $SYMPHONY_CONFIG_HOME/projects/<repository>.env

  GitHub (recommended): create a fine-grained personal access token at
  https://github.com/settings/personal-access-tokens/new

    Repository access: Only select repositories, then choose this repository.
    Repository permissions:
      Contents: Read and write       # clone, branches, and git push
      Pull requests: Read and write  # create/update PRs and merge them
      Issues: Read and write         # PR comments and labels (if used)

  Do not grant Administration, Actions, Secrets, Packages, or organization
  permissions. Add Workflows: Read and write only if Symphony must
  commit changes beneath .github/workflows/.

  A classic token is a fallback only: grant `repo`, and additionally `workflow`
  only when Symphony must modify .github/workflows/. Never use a token with
  `delete_repo`, and do not give it access to every repository.
EOF
}

install() {
  local install_missing=false
  case "${1:-}" in
    '') ;;
    --install-prerequisites) install_missing=true ;;
    *) die "unknown install option: $1" ;;
  esac

  [ -x "$symphony_home/elixir/bin/symphony" ] || die "missing Symphony runtime: $symphony_home/elixir/bin/symphony"
  if ! required_tools; then
    "$install_missing" || die 'rerun with --install-prerequisites after reviewing the changes it will make'
    install_prerequisites
    required_tools || die 'a prerequisite is still missing after installation'
  fi

  install_runtime
  ensure_launcher_link "$symphony_home/scripts/symphony-project" "$bin_dir/symphony-project"
  (umask 077; mkdir -p "$config_home/projects")
  printf 'Symphony runtime: %s\nConfiguration: %s\n' "$symphony_home" "$config_home"
  printf 'Next: run symphony-project init --linear-project <slug> inside a Git repository.\n'
}

update() {
  [ "$#" -eq 0 ] || die 'update does not accept arguments'
  [ -d "$symphony_home/.git" ] || die "Symphony source is not a Git checkout: $symphony_home"
  [ -z "$(git -C "$symphony_home" status --porcelain)" ] || die "Symphony source has uncommitted changes; update it manually: $symphony_home"

  local branch upstream remote before after
  branch=$(git -C "$symphony_home" branch --show-current)
  [ "$branch" = main ] || die "update requires the Symphony checkout on main, not ${branch:-detached HEAD}"
  upstream=$(git -C "$symphony_home" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null) || die 'main has no upstream; configure it before updating'
  remote=${upstream%%/*}
  before=$(git -C "$symphony_home" rev-parse HEAD)
  git -C "$symphony_home" fetch "$remote"
  git -C "$symphony_home" merge --ff-only "$upstream"
  after=$(git -C "$symphony_home" rev-parse HEAD)
  [ -z "$(git -C "$symphony_home" status --porcelain)" ] || die 'update left unexpected working-tree changes'

  install
  printf 'Updated Symphony: %s -> %s\n' "$before" "$after"
}

doctor() {
  local status=0
  printf 'Symphony runtime: %s\n' "$symphony_home"
  if [ ! -x "$symphony_home/elixir/bin/symphony" ]; then
    printf 'Missing packaged runtime: %s\n' "$symphony_home/elixir/bin/symphony" >&2
    status=1
  fi
  if ! required_tools; then status=1; fi
  if command -v mise >/dev/null 2>&1 && ! mise -C "$symphony_home/elixir" exec -- erl -noshell -eval 'halt().' >/dev/null 2>&1; then
    printf 'Missing Symphony Erlang runtime; run symphony-project install.\n' >&2
    status=1
  fi
  if [ ! -x "$bin_dir/symphony-project" ] && [ ! -L "$bin_dir/symphony-project" ]; then
    printf 'Global launcher is not installed: %s\n' "$bin_dir/symphony-project" >&2
    status=1
  fi
  if [ "$status" -eq 0 ]; then printf 'Symphony is ready.\n'; fi
  return "$status"
}

init() {
  local slug=${1:-}
  [ -n "$slug" ] || die 'init requires --linear-project <slug>'
  local root id remote workflow env_file skills_dir manifest launcher revision
  root=$(repo_root)
  id=$(project_id "$root")
  remote=$(git -C "$root" remote get-url origin 2>/dev/null || die 'the repository needs an origin remote')
  workflow="$root/WORKFLOW.md"
  env_file="$config_home/projects/$id.env"
  skills_dir="$root/.codex/skills"
  manifest="$root/.codex/symphony-skills.yml"
  launcher="$root/script/symphony"
  revision=$(git -C "$symphony_home" rev-parse HEAD 2>/dev/null || printf 'unknown')

  (umask 077; mkdir -p "$(dirname "$env_file")")
  mkdir -p "$skills_dir" "$(dirname "$launcher")"
  if [ ! -e "$env_file" ]; then (umask 077; cat >"$env_file" <<'EOF'
# Linear: Settings → Security & access → Personal API keys
LINEAR_API_KEY=
# GitHub: preferred fine-grained token. See `symphony-project --help` for the
# minimum repository permissions. Do not put this file in the repository.
GH_TOKEN=
EOF
); fi

  if [ ! -e "$workflow" ]; then cat >"$workflow" <<EOF
---
tracker:
  kind: linear
  provider:
    project_slug: "$slug"
    api_key: \$LINEAR_API_KEY
  required_labels: []
  active_states: ["Todo", "In Progress", "Merging", "Rework"]
  terminal_states: ["Closed", "Cancelled", "Canceled", "Duplicate", "Done"]
polling:
  interval_ms: 5000
workspace:
  root: ~/.local/share/symphony/workspaces/$id
hooks:
  after_create: |
    git clone --depth 1 "$remote" .
  before_remove: |
    git clean -ffdqx
agent:
  max_concurrent_agents: 10
  max_turns: 20
codex:
  command: codex --config shell_environment_policy.inherit=all app-server
  approval_policy: never
  thread_sandbox: workspace-write
  live_max_total_tokens: 500000
  live_max_turns: 5
  turn_sandbox_policy:
    type: workspaceWrite
    networkAccess: true
---

EOF
    printf '\nRepository: %s\nRemote: %s\n\n' "$id" "$remote" >>"$workflow"
    awk 'BEGIN { delimiters = 0 } /^---$/ { delimiters++; next } delimiters >= 2 { print }' \
      "$symphony_home/elixir/WORKFLOW.md" >>"$workflow"
  else
    printf 'Preserving existing %s\n' "$workflow"
  fi

  for skill in commit push pull linear land; do
    [ -e "$skills_dir/$skill" ] || cp -R "$symphony_home/.codex/skills/$skill" "$skills_dir/"
  done
  cat >"$manifest" <<EOF
bundle:
  source: $symphony_home
  revision: $revision
  mode: copied
skills: [commit, push, pull, linear, land]
EOF
  cat >"$launcher" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
exec symphony-project run "$@"
EOF
  chmod +x "$launcher"
  printf 'Created %s\nCredentials template: %s\nNext: fill credentials, then run %s\n' "$workflow" "$env_file" "$launcher"
}

run() {
  local root id env_file workflow runtime
  root=$(repo_root); id=$(project_id "$root")
  env_file="$config_home/projects/$id.env"; workflow="$root/WORKFLOW.md"
  [ -r "$env_file" ] || die "missing credentials file: $env_file"
  [ -f "$workflow" ] || die "missing workflow: $workflow"
  set -a; . "$env_file"; set +a
  runtime="$symphony_home/elixir/bin/symphony"
  [ -x "$runtime" ] || die "missing Symphony runtime: $runtime"

  # The packaged runtime is an escript. Run it in Symphony's mise project so
  # a target repository's own tool versions (or lack of Erlang) do not matter.
  if command -v mise >/dev/null 2>&1; then
    exec mise exec -C "$symphony_home/elixir" -- "$runtime" \
      --i-understand-that-this-will-be-running-without-the-usual-guardrails "$workflow" "$@"
  fi

  exec "$runtime" --i-understand-that-this-will-be-running-without-the-usual-guardrails "$workflow" "$@"
}

case "${1:-}" in
  install) shift; install "$@" ;;
  update) shift; update "$@" ;;
  doctor) shift; doctor "$@" ;;
  init) shift; [ "${1:-}" = --linear-project ] || { usage; exit 2; }; init "${2:-}" ;;
  run) shift; run "$@" ;;
  *) usage; exit 2 ;;
esac
