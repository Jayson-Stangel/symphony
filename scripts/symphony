#!/usr/bin/env bash
# Stable, checkout-backed command for a local Symphony runtime.
set -euo pipefail

die() { printf 'symphony: %s\n' "$*" >&2; exit 1; }

script_path=${BASH_SOURCE[0]}
while [ -L "$script_path" ]; do
  link=$(readlink "$script_path")
  case "$link" in
    /*) script_path=$link ;;
    *) script_path=$(cd "$(dirname "$script_path")" && cd "$(dirname "$link")" && pwd)/$(basename "$link") ;;
  esac
done
script_dir=$(cd "$(dirname "$script_path")" && pwd)
symphony_home=${SYMPHONY_HOME:-$(cd "$script_dir/.." && pwd)}
runner_namespace=${SYMPHONY_RUNNER_NAMESPACE:-}
if [ -n "$runner_namespace" ]; then
  [[ "$runner_namespace" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die 'SYMPHONY_RUNNER_NAMESPACE must contain 1-32 lowercase letters, digits or hyphens, starting with a letter or digit'
fi
runtime_prefix="symphony${runner_namespace:+-$runner_namespace}"
config_home=${SYMPHONY_CONFIG_HOME:-"${XDG_CONFIG_HOME:-$HOME/.config}/$runtime_prefix"}
bin_dir=${SYMPHONY_BIN_DIR:-"$HOME/.local/bin"}
skills_dir=${SYMPHONY_SKILLS_DIR:-"${CODEX_HOME:-$HOME/.codex}/skills"}
runner_home=${SYMPHONY_RUNNER_HOME:-"$config_home/runners"}

# Resolve derived storage after command options have selected configuration.
resolve_runner_home() { runner_home=${SYMPHONY_RUNNER_HOME:-"$config_home/runners"}; }
codex_auth_volume=${SYMPHONY_CODEX_AUTH_VOLUME:-$runtime_prefix-codex-auth}
managed_skills=(commit push pull linear land)

source_revision() { git -C "$symphony_home" rev-parse HEAD 2>/dev/null || printf 'unknown\n'; }

source_state() {
  if [ ! -d "$symphony_home/.git" ]; then
    printf 'unknown\n'
  elif [ -n "$(git -C "$symphony_home" status --porcelain 2>/dev/null)" ]; then
    printf 'dirty\n'
  else
    printf 'clean\n'
  fi
}

bool() { "$1" && printf 'true' || printf 'false'; }

ensure_launcher_link() {
  local source=$1 target=$2
  source=$(cd "$(dirname "$source")" && pwd)/$(basename "$source")
  mkdir -p "$(dirname "$target")"

  if [ -L "$target" ]; then
    [ "$(readlink "$target")" = "$source" ] || die "refusing to replace existing symlink: $target"
    printf 'Launcher: unchanged (%s)\n' "$target"
    return
  fi
  [ ! -e "$target" ] || die "refusing to replace existing path: $target"
  ln -s "$source" "$target"
  printf 'Launcher: created (%s)\n' "$target"
}

tool_available() { command -v "$1" >/dev/null 2>&1; }

required_tools() {
  local tool missing=0
  for tool in git mise gh codex; do
    if ! tool_available "$tool"; then
      printf 'Missing prerequisite: %s\n' "$tool" >&2
      missing=1
    fi
  done
  return "$missing"
}

runtime_ready() {
  tool_available mise && mise -C "$symphony_home/elixir" exec -- erl -noshell -eval 'halt().' >/dev/null 2>&1
}

install_prerequisites() {
  case "$(uname -s)" in
    Darwin)
      tool_available git || {
        xcode-select --install || true
        die 'install the Xcode Command Line Tools, then rerun symphony setup'
      }
      tool_available brew || die 'install Homebrew first: https://brew.sh'
      tool_available mise || brew install mise
      tool_available gh || brew install gh
      if ! tool_available codex; then
        tool_available npm || brew install node
        npm install -g @openai/codex@latest
      fi
      ;;
    *)
      die 'automatic prerequisite installation currently supports macOS only; install git, mise, gh, and Codex, then rerun symphony setup'
      ;;
  esac
}

repo_root() { git rev-parse --show-toplevel 2>/dev/null || die 'run this command inside a Git repository'; }

project_id() {
  local remote name
  remote=$(git -C "$1" remote get-url origin 2>/dev/null || true)
  name=$(basename "${remote:-$1}" .git | tr -cs '[:alnum:]._' '-' | sed 's/-*$//')
  printf '%s\n' "$name"
}

skill_name() { printf 'symphony-%s\n' "$1"; }

skill_source() { printf '%s/.codex/skills/%s\n' "$symphony_home" "$1"; }

global_skill_path() { printf '%s/%s\n' "$skills_dir" "$(skill_name "$1")"; }

managed_skill() {
  local skill
  for skill in "${managed_skills[@]}"; do [ "$skill" = "$1" ] && return 0; done
  return 1
}

ensure_global_skills() {
  local skill source target
  for skill in "${managed_skills[@]}"; do
    source=$(skill_source "$skill")
    target=$(global_skill_path "$skill")
    [ -d "$source" ] || die "missing bundled skill: $skill"
    if [ -L "$target" ]; then
      [ "$(readlink "$target")" = "$source" ] || die "refusing to replace existing global skill link: $target"
    elif [ -e "$target" ]; then
      die "refusing to replace existing global skill: $target"
    fi
  done
  mkdir -p "$skills_dir"
  for skill in "${managed_skills[@]}"; do
    source=$(skill_source "$skill")
    target=$(global_skill_path "$skill")
    [ -L "$target" ] || ln -s "$source" "$target"
  done
  printf 'Skills: linked globally (%s)\n' "$skills_dir"
}

global_skills_ready() {
  local skill source target
  for skill in "${managed_skills[@]}"; do
    source=$(skill_source "$skill")
    target=$(global_skill_path "$skill")
    [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ] || return 1
  done
}

usage() {
  cat <<'EOF'
Usage:
  symphony --version
  symphony install [--bin-dir PATH] [--config-dir PATH] [--skills-dir PATH]
  symphony setup [--install-prerequisites]
  symphony doctor [--json] [--bin-dir PATH] [--config-dir PATH] [--skills-dir PATH]
  symphony update [--development-runner] [--agent codex|claude | --pause-runner | --rollback-runner] [--bin-dir PATH] [--config-dir PATH] [--skills-dir PATH]
  symphony init --linear-project SLUG [--local-skill NAME]...
  symphony skill override NAME
  symphony skill migrate-local NAME
  symphony skill use-global NAME
  symphony project doctor [--json]
  symphony auth codex {login|check|remove}
  symphony auth claude {login|check|remove}
  symphony runner start|stop|status|doctor|logs|drain|resume|recheck
  symphony run [--agent codex|claude] [--port PORT] [--host]

Run this command from a clean, stable Symphony checkout such as ~/src/symphony.
`install` only links the command and creates protected configuration storage.
`setup` deliberately installs or repairs prerequisites and the pinned mise runtime.
`update` fast-forwards the tracked main branch and keeps its global skills linked
to the stable runtime; it never overwrites project files.

Use SYMPHONY_HOME when this script is copied outside its checkout. Set
SYMPHONY_BIN_DIR, SYMPHONY_CONFIG_HOME, and SYMPHONY_SKILLS_DIR to use alternate
locations. Symphony installs namespaced global skills, such as `symphony-land`,
to avoid affecting unrelated Codex work. Use `skill override` only when a
repository genuinely needs to customize one of them. `project doctor` is
read-only and identifies legacy project configuration safely.

For a separate development checkout, set SYMPHONY_RUNNER_NAMESPACE as well as
separate configuration paths and a separate dashboard port. The namespace
isolates Docker container names, images, workspace/state and native auth volumes.
`update --development-runner --agent ...` transitions only that namespace using
the current checkout; it does not fetch main, install links or run host setup.
See docs/development.md. Leave the namespace unset for the stable installation.

Credentials created by init are stored outside the repository at:
  $SYMPHONY_CONFIG_HOME/projects/<repository>.env

GitHub tokens should be fine-grained and repository-scoped. Grant Contents and
Pull requests: Read and write; grant Issues or Workflows only when needed.

An isolated runner logs into Codex in a Docker-managed volume with
`symphony auth codex login`; it never mounts a host Codex login or adds one to
a project .env file.

`symphony run` starts the full listener, web UI, Codex, and Git workspaces in
a Docker- or Podman-compatible container. Use `--host` only for local debugging.
EOF
}

install() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --bin-dir) [ "$#" -ge 2 ] || die '--bin-dir requires a path'; bin_dir=$2; shift 2 ;;
      --config-dir) [ "$#" -ge 2 ] || die '--config-dir requires a path'; config_home=$2; shift 2 ;;
      --skills-dir) [ "$#" -ge 2 ] || die '--skills-dir requires a path'; skills_dir=$2; shift 2 ;;
      --help|-h) printf 'Usage: symphony install [--bin-dir PATH] [--config-dir PATH] [--skills-dir PATH]\n'; return ;;
      *) die "unknown install option: $1" ;;
    esac
  done
  ensure_launcher_link "$symphony_home/scripts/symphony" "$bin_dir/symphony"
  (umask 077; mkdir -p "$config_home/projects")
  ensure_global_skills
  printf 'Runtime: %s\nConfiguration: %s\nNext: run symphony setup, then symphony init inside a Git repository.\n' \
    "$symphony_home" "$config_home"
}

setup() {
  local install_missing=false
  case "${1:-}" in
    '') ;;
    --install-prerequisites) install_missing=true ;;
    --help|-h) printf 'Usage: symphony setup [--install-prerequisites]\n'; return ;;
    *) die "unknown setup option: $1" ;;
  esac

  if ! required_tools; then
    "$install_missing" || die 'rerun with --install-prerequisites after reviewing the changes it will make'
    install_prerequisites
    required_tools || die 'a prerequisite is still missing after installation'
  fi
  mise -C "$symphony_home/elixir" install
  runtime_ready || die 'mise completed but the Symphony Erlang runtime is unavailable'
  mise -C "$symphony_home/elixir" exec -- mix setup
  mise -C "$symphony_home/elixir" exec -- mix build
  [ -x "$symphony_home/elixir/bin/symphony" ] || die 'runtime build completed without creating elixir/bin/symphony'
  printf 'Runtime setup complete: %s\n' "$symphony_home/elixir"
}

update() {
  local transition_target= development_runner=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --agent)
        [ "$#" -ge 2 ] || die '--agent requires codex or claude'
        [ -z "$transition_target" ] || die 'choose only one runner transition'
        validate_agent "$2"; transition_target=$2; shift 2 ;;
      --pause-runner)
        [ -z "$transition_target" ] || die 'choose only one runner transition'
        transition_target=pause; shift ;;
      --rollback-runner)
        [ -z "$transition_target" ] || die 'choose only one runner transition'
        transition_target=rollback; shift ;;
      --development-runner) development_runner=true; shift ;;
      --bin-dir|--config-dir|--skills-dir)
        [ "$#" -ge 2 ] || die "$1 requires a path"
        if [ "$1" = --bin-dir ]; then bin_dir=$2; elif [ "$1" = --config-dir ]; then config_home=$2; else skills_dir=$2; fi
        shift 2 ;;
      --help|-h) printf 'Usage: symphony update [--development-runner] [--agent codex|claude | --rollback-runner | --pause-runner] [--bin-dir PATH] [--config-dir PATH] [--skills-dir PATH]\n'; return ;;
      *) die "unknown update option: $1" ;;
    esac
  done

  resolve_runner_home

  if "$development_runner"; then
    [ -n "$runner_namespace" ] || die '--development-runner requires SYMPHONY_RUNNER_NAMESPACE to isolate Docker resources'
    [ -n "$transition_target" ] || die '--development-runner requires --agent, --pause-runner or --rollback-runner'
    case "$transition_target" in
      pause) runner_pause "$(repo_root)" true ;;
      rollback) runner_rollback "$(repo_root)" ;;
      *) runner_transition "$(repo_root)" "$transition_target" true ;;
    esac
    return
  fi

  if [ "$transition_target" = pause ]; then runner_pause "$(repo_root)" true; return; fi
  if [ "$transition_target" = rollback ]; then
    runner_rollback "$(repo_root)"
    return
  fi

  [ -d "$symphony_home/.git" ] || die "Symphony source is not a Git checkout: $symphony_home"
  [ -z "$(git -C "$symphony_home" status --porcelain)" ] || die "Symphony source has uncommitted changes; update it manually: $symphony_home"
  local branch upstream remote merge_ref before after
  branch=$(git -C "$symphony_home" branch --show-current)
  [ "$branch" = main ] || die "update requires main, not ${branch:-detached HEAD}"
  remote=$(git -C "$symphony_home" config --get branch.main.remote) || die 'main has no upstream remote; configure it before updating'
  merge_ref=$(git -C "$symphony_home" config --get branch.main.merge) || die 'main has no upstream branch; configure it before updating'
  [ "$merge_ref" = refs/heads/main ] || die "update requires the upstream main branch, not $merge_ref"
  [ "$remote" != . ] && git -C "$symphony_home" remote get-url "$remote" >/dev/null 2>&1 || die 'main must track main on a configured remote'
  upstream="refs/remotes/$remote/main"
  before=$(git -C "$symphony_home" rev-parse HEAD)
  # Restrict pruning to this remote's tracking branches, even with custom fetch mappings.
  git -C "$symphony_home" fetch --prune --no-prune-tags --refmap= "$remote" \
    "+refs/heads/*:refs/remotes/$remote/*"
  git -C "$symphony_home" merge --ff-only "$upstream"
  after=$(git -C "$symphony_home" rev-parse HEAD)
  [ -z "$(git -C "$symphony_home" status --porcelain)" ] || die 'update left unexpected working-tree changes'
  "$symphony_home/scripts/symphony" install --bin-dir "$bin_dir" --config-dir "$config_home" --skills-dir "$skills_dir"
  if [ "$before" != "$after" ]; then
    "$symphony_home/scripts/symphony" setup
  fi
  if [ -n "$transition_target" ]; then runner_transition "$(repo_root)" "$transition_target"; fi
  printf 'Updated: %s -> %s\n' "$before" "$after"
}

doctor() {
  local json=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) json=true; shift ;;
      --bin-dir|--config-dir|--skills-dir)
        [ "$#" -ge 2 ] || die "$1 requires a path"
        if [ "$1" = --bin-dir ]; then bin_dir=$2; elif [ "$1" = --config-dir ]; then config_home=$2; else skills_dir=$2; fi
        shift 2 ;;
      --help|-h) printf 'Usage: symphony doctor [--json] [--bin-dir PATH] [--config-dir PATH] [--skills-dir PATH]\n'; return ;;
      *) die "unknown doctor option: $1" ;;
    esac
  done

  local git_ok mise_ok gh_ok codex_ok runtime_ok launcher_ok source_ok skills_ok ready=true
  git_ok=false; tool_available git && git_ok=true
  mise_ok=false; tool_available mise && mise_ok=true
  gh_ok=false; tool_available gh && gh_ok=true
  codex_ok=false; tool_available codex && codex_ok=true
  runtime_ok=false; runtime_ready && runtime_ok=true
  launcher_ok=false; [ -L "$bin_dir/symphony" ] && [ "$(readlink "$bin_dir/symphony")" = "$symphony_home/scripts/symphony" ] && launcher_ok=true
  source_ok=false; [ -x "$symphony_home/elixir/bin/symphony" ] && source_ok=true
  skills_ok=false; global_skills_ready && skills_ok=true
  "$git_ok" && "$mise_ok" && "$gh_ok" && "$codex_ok" && "$runtime_ok" && "$launcher_ok" && "$source_ok" && "$skills_ok" || ready=false

  if "$json"; then
    printf '{"mode":"doctor","ready":%s,"source_revision":"%s","source_state":"%s","checks":{"source":%s,"launcher":%s,"skills":%s,"git":%s,"mise":%s,"gh":%s,"codex":%s,"runtime":%s}}\n' \
      "$(bool "$ready")" "$(source_revision)" "$(source_state)" "$(bool "$source_ok")" "$(bool "$launcher_ok")" \
      "$(bool "$skills_ok")" "$(bool "$git_ok")" "$(bool "$mise_ok")" "$(bool "$gh_ok")" "$(bool "$codex_ok")" "$(bool "$runtime_ok")"
  else
    printf 'Symphony %s (%s)\n' "$(source_revision)" "$(source_state)"
    printf 'source=%s launcher=%s skills=%s git=%s mise=%s gh=%s codex=%s runtime=%s\n' \
      "$source_ok" "$launcher_ok" "$skills_ok" "$git_ok" "$mise_ok" "$gh_ok" "$codex_ok" "$runtime_ok"
    "$ready" && printf 'Ready.\n' || printf 'Not ready. Run symphony install and symphony setup as needed.\n' >&2
  fi
  "$ready"
}

record_local_override() {
  local root=$1 skill=$2 origin=$3 manifest
  manifest="$root/.codex/symphony-skill-overrides.yml"
  if [ ! -e "$manifest" ]; then
    cat >"$manifest" <<'EOF'
# Local skills in this file deliberately shadow Symphony's global skills.
# They stop receiving runtime updates until this override is removed.
overrides:
EOF
  fi
  printf '  - name: %s\n    source: %s\n    source_revision: %s\n' \
    "$(skill_name "$skill")" "$origin" "$(source_revision)" >>"$manifest"
}

remove_override_record() {
  local root=$1 skill=$2 manifest temporary name
  manifest="$root/.codex/symphony-skill-overrides.yml"
  [ -f "$manifest" ] || return 0
  name=$(skill_name "$skill")
  temporary=$(mktemp "${TMPDIR:-/tmp}/symphony-overrides.XXXXXX")
  awk -v name="$name" '
    $0 == "  - name: " name { skip = 1; next }
    skip && /^    source: / { next }
    skip && /^    source_revision: / { skip = 0; next }
    { print }
  ' "$manifest" >"$temporary"
  mv "$temporary" "$manifest"
}

create_local_override() {
  local root=$1 skill=$2 source target
  managed_skill "$skill" || die "unknown managed skill: $skill"
  source=$(skill_source "$skill")
  target="$root/.codex/skills/$(skill_name "$skill")"
  [ -d "$source" ] || die "missing bundled skill: $skill"
  [ ! -e "$target" ] || die "local override already exists: $target"
  mkdir -p "$(dirname "$target")"
  cp -R "$source" "$target"
  record_local_override "$root" "$skill" 'global'
  printf 'Local skill override: %s\n' "$target"
}

set_skill_name() {
  local directory=$1 name=$2 temporary
  temporary=$(mktemp "${TMPDIR:-/tmp}/symphony-skill.XXXXXX")
  awk -v name="$name" '
    !updated && /^name: / { print "name: " name; updated = 1; next }
    { print }
  ' "$directory/SKILL.md" >"$temporary"
  mv "$temporary" "$directory/SKILL.md"
}

migrate_legacy_skill() {
  local root=$1 skill=$2 source target
  managed_skill "$skill" || die "unknown managed skill: $skill"
  source="$root/.codex/skills/$skill"
  target="$root/.codex/skills/$(skill_name "$skill")"
  [ -d "$source" ] || die "legacy local skill is missing: $source"
  [ ! -e "$target" ] || die "local override already exists: $target"
  mkdir -p "$(dirname "$target")"
  cp -R "$source" "$target"
  set_skill_name "$target" "$(skill_name "$skill")"
  record_local_override "$root" "$skill" "legacy:$source"
  printf 'Legacy skill preserved as local override: %s\nOriginal preserved: %s\n' "$target" "$source"
}

use_global_skill() {
  local root=$1 skill=$2 target backup
  managed_skill "$skill" || die "unknown managed skill: $skill"
  target="$root/.codex/skills/$(skill_name "$skill")"
  [ -d "$target" ] || die "local override is missing: $target"
  backup="$root/.codex/symphony-skill-backups/$(date +%Y%m%d%H%M%S)-$(skill_name "$skill")"
  [ ! -e "$backup" ] || die "refusing to replace existing backup: $backup"
  mkdir -p "$(dirname "$backup")"
  mv "$target" "$backup"
  remove_override_record "$root" "$skill"
  printf 'Global skill restored: %s\nLocal override backed up: %s\n' "$(global_skill_path "$skill")" "$backup"
}

init() {
  local slug='' root id remote workflow env_file skill
  local -a local_skills
  local_skills=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --linear-project) [ "$#" -ge 2 ] || die '--linear-project requires a slug'; slug=$2; shift 2 ;;
      --local-skill) [ "$#" -ge 2 ] || die '--local-skill requires a name'; local_skills+=("$2"); shift 2 ;;
      --help|-h) printf 'Usage: symphony init --linear-project SLUG [--local-skill NAME]...\n'; return ;;
      *) die "unknown init option: $1" ;;
    esac
  done
  [ -n "$slug" ] || die 'init requires --linear-project <slug>'
  global_skills_ready || ensure_global_skills
  root=$(repo_root)
  id=$(project_id "$root")
  remote=$(git -C "$root" remote get-url origin 2>/dev/null || die 'the repository needs an origin remote')
  workflow="$root/WORKFLOW.md"
  env_file="$config_home/projects/$id.env"

  (umask 077; mkdir -p "$(dirname "$env_file")")
  if [ ! -e "$env_file" ]; then (umask 077; cat >"$env_file" <<'EOF'
# Linear: Settings → Security & access → Personal API keys
LINEAR_API_KEY=
# GitHub: fine-grained, repository-scoped token. See `symphony --help`.
GH_TOKEN=
EOF
); fi

  if [ ! -e "$workflow" ]; then cat >"$workflow" <<EOF
---
tracker:
  kind: linear
  provider:
    project_slug: "$slug"
    api_key: \$LINEAR_API_KEY
  required_labels: []
  active_states: ["Todo", "In Progress", "Merging", "Rework"]
  blocked_states: ["Blocked"]
  terminal_states: ["Closed", "Cancelled", "Canceled", "Duplicate", "Done"]
polling:
  interval_ms: 5000
workspace:
  root: ~/.local/share/symphony/workspaces/$id
  clone_url: "$remote"
hooks:
  before_remove: |
    git clean -ffdqx
agent:
  max_concurrent_agents: 10
  max_turns: 20
codex:
  command: codex --config shell_environment_policy.inherit=all app-server
  approval_policy: never
  thread_sandbox: workspace-write
  turn_sandbox_policy:
    type: workspaceWrite
    networkAccess: true
---

EOF
    printf '\nRepository: %s\nRemote: %s\n\n' "$id" "$remote" >>"$workflow"
    awk 'BEGIN { delimiters = 0 } /^---$/ { delimiters++; next } delimiters >= 2 { print }' "$symphony_home/elixir/WORKFLOW.md" >>"$workflow"
  else
    printf 'Workflow: preserved (%s)\n' "$workflow"
  fi

  if [ "${#local_skills[@]}" -gt 0 ]; then
    for skill in "${local_skills[@]}"; do create_local_override "$root" "$skill"; done
  fi
  printf 'Project: initialized (%s)\nSkills: global (use --local-skill only for deliberate overrides)\nCredentials: %s\nNext: fill credentials, authenticate the isolated runtime with symphony auth codex login, then run symphony run\n' "$workflow" "$env_file"
}

skill() {
  local action=${1:-} name=${2:-}
  case "$action" in
    override|migrate-local|use-global) ;;
    *) printf 'Usage: symphony skill {override|migrate-local|use-global} NAME\n' >&2; return 2 ;;
  esac
  [ -n "$name" ] || die "skill $action requires a skill name"
  global_skills_ready || die 'global Symphony skills are missing; run symphony install first'
  case "$action" in
    override) create_local_override "$(repo_root)" "$name" ;;
    migrate-local) migrate_legacy_skill "$(repo_root)" "$name" ;;
    use-global) use_global_skill "$(repo_root)" "$name" ;;
  esac
}

project_doctor() {
  local json=$1 root id workflow env_file legacy_manifest legacy_count=0 override_count=0 legacy_refs=false wrapper=false skill
  root=$(repo_root)
  id=$(project_id "$root")
  workflow="$root/WORKFLOW.md"
  env_file="$config_home/projects/$id.env"
  legacy_manifest="$root/.codex/symphony-skills.yml"
  for skill in "${managed_skills[@]}"; do
    [ -d "$root/.codex/skills/$skill" ] && legacy_count=$((legacy_count + 1))
    [ -d "$root/.codex/skills/$(skill_name "$skill")" ] && override_count=$((override_count + 1))
  done
  [ -e "$root/script/symphony" ] && wrapper=true
  if [ -f "$workflow" ] && grep -Eq '(`(linear|commit|push|pull|land)`|\.codex/skills/(commit|push|pull|linear|land))' "$workflow"; then legacy_refs=true; fi

  if "$json"; then
    printf '{"mode":"project-doctor","workflow":%s,"credentials":%s,"global_skills":%s,"legacy_manifest":%s,"legacy_skill_count":%s,"local_override_count":%s,"legacy_workflow_references":%s,"legacy_wrapper":%s}\n' \
      "$(bool "$( [ -f "$workflow" ] && printf true || printf false )")" \
      "$(bool "$( [ -f "$env_file" ] && printf true || printf false )")" \
      "$(bool "$( global_skills_ready && printf true || printf false )")" \
      "$(bool "$( [ -f "$legacy_manifest" ] && printf true || printf false )")" \
      "$legacy_count" "$override_count" "$(bool "$legacy_refs")" "$(bool "$wrapper")"
    return
  fi

  printf 'Project: %s\nWorkflow: %s\nCredentials: %s\nGlobal skills: %s\n' \
    "$root" "$([ -f "$workflow" ] && printf present || printf missing)" \
    "$([ -f "$env_file" ] && printf present || printf missing)" \
    "$(global_skills_ready && printf ready || printf missing)"
  printf 'Legacy copied skills: %s\nLocal namespaced overrides: %s\nLegacy skill manifest: %s\nLegacy wrapper: %s\nLegacy workflow references: %s\n' \
    "$legacy_count" "$override_count" "$([ -f "$legacy_manifest" ] && printf present || printf absent)" "$wrapper" "$legacy_refs"
  if [ "$legacy_count" -gt 0 ]; then
    printf '\nLegacy skills are preserved and are not changed automatically. If a skill contains intentional team changes, preserve it with:\n  symphony skill migrate-local NAME\nThis creates a namespaced override and preserves the original; review cross-skill references afterward.\n'
  fi
  if "$legacy_refs"; then
    printf '\nWORKFLOW.md still names legacy local-skill paths. It is preserved; review it and change only the intended references to the namespaced global skill names.\n'
  fi
  if "$wrapper"; then
    printf '\nThe legacy script/symphony wrapper is redundant. Keep or remove it through the repository’s normal review process.\n'
  fi
}

project() {
  local command=${1:-} json=false
  [ "$command" = doctor ] || { printf 'Usage: symphony project doctor [--json]\n' >&2; return 2; }
  case "${2:-}" in
    '') ;;
    --json) json=true ;;
    *) die "unknown project doctor option: $2" ;;
  esac
  project_doctor "$json"
}

container_runtime() {
  local candidate
  if [ -n "${SYMPHONY_CONTAINER_RUNTIME:-}" ]; then
    tool_available "$SYMPHONY_CONTAINER_RUNTIME" || die "container runtime is unavailable: $SYMPHONY_CONTAINER_RUNTIME"
    printf '%s\n' "$SYMPHONY_CONTAINER_RUNTIME"
    return
  fi
  for candidate in docker podman; do
    if tool_available "$candidate"; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  die 'no compatible container runtime found; install Docker, OrbStack, or Podman'
}

runner_id() { printf '%s\n' "$runtime_prefix-$(project_id "$1")"; }
runner_storage_id() {
  local remote digest
  remote=$(git -C "$1" remote get-url origin)
  remote=$(printf '%s' "$remote" | sed -E 's#^[^@/]+@([^:]+):#\1/#; s#^[[:alnum:]+.-]+://##; s#^[^/@]+@##; s#\.git/?$##; s#/$##')
  digest=$(printf '%s' "$remote" | git hash-object --stdin)
  printf '%s-%s\n' "$(runner_id "$1")" "${digest:0:12}"
}
runner_env_file() { printf '%s/%s.env\n' "$runner_home" "$(project_id "$1")"; }

validate_agent() {
  case "$1" in codex|claude) ;; *) die 'agent must be codex or claude' ;; esac
}

runner_local_image() {
  local agent=${1:-codex}
  validate_agent "$agent"
  if [ "$agent" = claude ]; then printf '%s-runner-claude:local\n' "$runtime_prefix"
  else printf '%s-runner:local\n' "$runtime_prefix"; fi
}

runner_image() {
  if [ -n "${SYMPHONY_RUNNER_IMAGE:-}" ]; then printf '%s\n' "$SYMPHONY_RUNNER_IMAGE"
  else runner_local_image "${1:-codex}"; fi
}

runner_build_image() {
  local runtime image agent=${1:-codex}
  validate_agent "$agent"
  runtime=$(container_runtime); image=$(runner_image "$agent")
  "$runtime" build --target "$agent" --file "$symphony_home/runner/Dockerfile" -t "$image" "$symphony_home"
}

claude_auth_volume() { printf '%s-claude-auth\n' "$(runner_storage_id "$1")"; }

claude_image_ready() {
  local runtime=$1 image=$2 agent uid
  agent=$("$runtime" image inspect --format '{{ index .Config.Labels "com.symphony.agent" }}' "$image")
  uid=$("$runtime" image inspect --format '{{.Config.User}}' "$image")
  [ "$agent" = claude ] && [ "$uid" = 11001:11001 ] || die 'Claude image does not meet the non-root runner contract'
}

ensure_claude_auth_volume() {
  local root=$1 runtime=$2 volume=$3 storage owner
  storage=$(runner_storage_id "$root")
  if "$runtime" volume inspect "$volume" >/dev/null 2>&1; then
    owner=$("$runtime" volume inspect --format '{{ index .Labels "com.symphony.storage" }}' "$volume")
    [ "$owner" = "$storage" ] || die 'refusing a foreign or unqualified Claude auth volume'
  else
    "$runtime" volume create --label "com.symphony.storage=$storage" "$volume" >/dev/null
  fi
}

claude_auth() {
  local action=$1 root runtime image volume users
  shift
  case "$action" in
    login|check|remove) [ "$#" = 0 ] || die "auth claude $action takes no arguments" ;;
    *) die 'Usage: symphony auth claude login|check|remove' ;;
  esac
  root=$(repo_root); runtime=$(container_runtime); image=$(runner_image claude)
  volume=$(claude_auth_volume "$root")
  if ! "$runtime" image inspect "$image" >/dev/null 2>&1; then
    [ "$action" = login ] || die 'Claude image is missing; provision it with symphony auth claude login first'
    runner_build_image claude
  fi
  claude_image_ready "$runtime" "$image"
  if [ "$action" != login ]; then
    "$runtime" volume inspect "$volume" >/dev/null 2>&1 || die 'no project-scoped Claude login; run symphony auth claude login'
  fi
  ensure_claude_auth_volume "$root" "$runtime" "$volume"
  if [ "$action" = login ] || [ "$action" = remove ]; then
    users=$("$runtime" ps --filter "volume=$volume" --format '{{.ID}}')
    [ -z "$users" ] || die 'Claude profile is in use; drain it through symphony update before changing its native login'
  fi
  if [ "$action" = login ]; then
    "$runtime" run --rm --interactive --tty --name "$(runner_storage_id "$root")-claude-auth" \
      --label "com.symphony.storage=$(runner_storage_id "$root")" \
      --read-only --cap-drop ALL --security-opt no-new-privileges \
      --tmpfs /tmp:rw,nosuid,nodev,size=128m \
      --volume "$volume:/home/claude" --entrypoint /usr/local/bin/node "$image" /opt/symphony/claude/auth.mjs login
    printf 'Native login retained.\n'
  elif [ "$action" = check ]; then
    "$runtime" run --rm --name "$(runner_storage_id "$root")-claude-auth" \
      --label "com.symphony.storage=$(runner_storage_id "$root")" \
      --read-only --cap-drop ALL --security-opt no-new-privileges \
      --tmpfs /tmp:rw,nosuid,nodev,size=128m \
      --volume "$volume:/home/claude" \
      --entrypoint /usr/local/bin/node "$image" /opt/symphony/claude/auth.mjs check
  else
    "$runtime" run --rm --name "$(runner_storage_id "$root")-claude-auth" \
      --label "com.symphony.storage=$(runner_storage_id "$root")" \
      --read-only --cap-drop ALL --security-opt no-new-privileges \
      --tmpfs /tmp:rw,nosuid,nodev,size=128m \
      --volume "$volume:/home/claude" --entrypoint /usr/local/bin/node "$image" /opt/symphony/claude/auth.mjs logout
    "$runtime" volume rm "$volume" >/dev/null
    printf 'Native logout completed and local profile removed; server revocation follows native runtime semantics.\n'
  fi
}

# Native readiness owns the account identity; no separate billing artifact.
claude_native_profile() {
  claude_auth check | python3 -c 'import json,re,sys
try:
 data=sys.stdin.read(4097); value=json.loads(data); profile=value.get("profile")
 if not (len(data) <= 4096 and value.get("ready") is True and isinstance(profile,str) and re.fullmatch("[a-f0-9]{64}",profile)): sys.exit(1)
 print(profile)
except Exception:
 sys.exit(1)'
}

auth_codex_login() {
  local runtime image
  runtime=$(container_runtime); image=$(runner_image)
  runner_build_image
  "$runtime" volume create "$codex_auth_volume" >/dev/null
  printf 'Open the displayed URL and complete the Codex device login.\n'
  "$runtime" run --rm --interactive --tty \
    --volume "$codex_auth_volume:/root/.codex" \
    --entrypoint codex "$image" login --device-auth
}

auth_codex_remove() {
  local runtime
  runtime=$(container_runtime)
  "$runtime" volume rm "$codex_auth_volume" >/dev/null
  printf 'Docker-managed Codex session removed: %s\n' "$codex_auth_volume"
}

auth_codex_check() {
  local runtime image
  runtime=$(container_runtime); image=$(runner_image)
  "$runtime" volume inspect "$codex_auth_volume" >/dev/null 2>&1 || die 'no Docker-managed Codex session; run: symphony auth codex login'
  "$runtime" run --rm \
    --volume "$codex_auth_volume:/root/.codex" \
    --entrypoint codex "$image" login status
  printf 'Docker-managed Codex session is ready for isolated runners.\n'
}

auth() {
  local provider=${1:-} action=${2:-}
  if [ "$provider" = claude ]; then shift 2 || true; claude_auth "$action" "$@"; return; fi
  [ "$provider" = codex ] || { printf 'Usage: symphony auth codex {login|check|remove}\n' >&2; return 2; }
  shift 2 || true
  case "$action" in
    login) [ "$#" -eq 0 ] || die 'Usage: symphony auth codex login'; auth_codex_login ;;
    check) [ "$#" -eq 0 ] || die 'Usage: symphony auth codex check'; auth_codex_check ;;
    remove) [ "$#" -eq 0 ] || die 'Usage: symphony auth codex remove'; auth_codex_remove ;;
    *) printf 'Usage: symphony auth codex {login|check|remove}\n' >&2; return 2 ;;
  esac
}

runner_status() {
  local root=$1 runtime name state
  runtime=$(container_runtime); name=$(runner_id "$root")
  if state=$("$runtime" inspect --format '{{.State.Running}}' "$name" 2>/dev/null); then
    printf '%s\n' "$state"
  else
    printf 'missing\n'
  fi
}

runner_report() {
  local root=$1 state name storage_id runtime agent port image
  runtime=$(container_runtime); state=$(runner_status "$root"); name=$(runner_id "$root")
  if [ "$state" = missing ]; then printf 'Isolated worker: not running\n'; return; fi
  storage_id=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.storage" }}' "$name")
  [ "$storage_id" = "$(runner_storage_id "$root")" ] || die "container $name has unknown or foreign repository storage"
  if [ "$("$runtime" inspect --format '{{.State.Restarting}}' "$name")" = true ]; then
    printf 'Isolated worker: restarting; inspect runner logs for the startup error.\n'
    return
  fi
  if [ "$state" != true ]; then printf 'Isolated worker: stopped (%s)\n' "$state"; return; fi
  agent=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.agent" }}' "$name")
  validate_agent "$agent"
  port=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.port" }}' "$name")
  image=$("$runtime" inspect --format '{{.Image}}' "$name")
  printf 'Isolated Symphony: running\nContainer: %s\nAgent: %s\nImage: %s\nDashboard: http://127.0.0.1:%s\nWorkspaces: /workspaces (volume %s-workspaces)\nRuntime logs: volume %s-state\n' \
    "$name" "$agent" "$image" "$port" "$storage_id" "$storage_id"
  if [ "$agent" = claude ]; then
    printf 'Claude native login: project-scoped volume %s\n' "$(claude_auth_volume "$root")"
  else
    printf 'Codex session: Docker volume %s\n' "$codex_auth_volume"
  fi
}

runner_start() {
  local root=$1 port=${2:-4010} agent=${3:-codex} authority=${4:-run} id project_env runtime name state image env_file git_token workflow storage_id existing_storage existing_agent image_id existing_image profile=none auth_volume
  validate_agent "$agent"
  case "$port" in ''|*[!0-9]*) die 'port must be an integer between 1 and 65535' ;; esac
  [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die 'port must be between 1 and 65535'
  id=$(project_id "$root"); runtime=$(container_runtime); name=$(runner_id "$root")
  env_file="$runner_home/$id.env"; image=$(runner_image "$agent"); workflow="$root/WORKFLOW.md"
  storage_id=$(runner_storage_id "$root")
  project_env="$config_home/projects/$id.env"
  [ -r "$project_env" ] || die "missing credentials file: $project_env"
  git_token=$(unset GH_TOKEN GITHUB_TOKEN; set -a; . "$project_env"; printf '%s' "${GH_TOKEN:-${GITHUB_TOKEN:-}}")
  if [ "$agent" = codex ]; then
    "$runtime" volume inspect "$codex_auth_volume" >/dev/null 2>&1 || die 'no Docker-managed Codex session; run: symphony auth codex login'
  else
    auth_volume=$(claude_auth_volume "$root")
    "$runtime" volume inspect "$auth_volume" >/dev/null 2>&1 || die 'no project-scoped Claude session; run: symphony auth claude login'
    ensure_claude_auth_volume "$root" "$runtime" "$auth_volume"
  fi
  [ -n "$git_token" ] || die 'missing GITHUB_TOKEN or GH_TOKEN for the isolated runner'

  state=$(runner_status "$root")
  if [ "$state" != missing ]; then
    existing_storage=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.storage" }}' "$name")
    [ "$existing_storage" = "$storage_id" ] || die "container $name has legacy or foreign storage; refusing to replace it"
    [ "$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.mode" }}' "$name")" = listener ] || die 'existing container is not a qualified listener; use the installed updater'
  fi
  if [ "$state" = true ]; then
    if [ "$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.mode" }}' "$name")" = listener ]; then
      [ "$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.storage" }}' "$name")" = "$storage_id" ] ||
        die "existing listener $name has legacy or different repository storage; back up its workspaces before stopping and replacing it"
      [ -r "$env_file" ] || die "runner is running but its configuration is missing: $env_file"
      [ "$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.port" }}' "$name")" = "$port" ] ||
        die 'listener port differs; transition through symphony update --agent'
      existing_agent=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.agent" }}' "$name")
      [ "$existing_agent" = "$agent" ] || die 'listener agent differs or is unqualified; transition through symphony update --agent'
      image_id=$("$runtime" image inspect --format '{{.Id}}' "$image")
      existing_image=$("$runtime" inspect --format '{{.Image}}' "$name")
      [ -n "$image_id" ] && [ "$image_id" = "$existing_image" ] || die 'listener image differs; transition through symphony update --agent'
      if [ "$agent" = claude ]; then
        profile=$(claude_native_profile)
        [ "$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.profile" }}' "$name")" = "$profile" ] || die 'listener native profile differs; transition through symphony update --agent'
      fi
      return
    fi
    die 'existing container cannot be reused; use the installed updater'
  fi
  if [ -r "$env_file" ] && [ "$authority" != update ]; then
    (
      . "$env_file"
      [ "${SYMPHONY_RUNNER_AGENT:-}" = "$agent" ] || die 'provider transition requires symphony update --agent'
    ) || return 1
  fi

  if ! "$runtime" image inspect "$image" >/dev/null 2>&1; then runner_build_image "$agent"; fi
  image_id=$("$runtime" image inspect --format '{{.Id}}' "$image")
  [ -n "$image_id" ] || die 'runner image identity is unavailable'
  if [ -r "$env_file" ] && [ "$authority" != update ]; then
    (
      . "$env_file"
      [ "${SYMPHONY_RUNNER_IMAGE_ID:-}" = "$image_id" ] || die 'image change requires symphony update --agent'
    ) || return 1
  fi
  if [ "$agent" = claude ]; then profile=$(claude_native_profile); fi
  if [ -r "$env_file" ] && [ "$authority" != update ]; then
    (
      . "$env_file"
      [ "${SYMPHONY_RUNNER_PROFILE:-none}" = "$profile" ] || die 'native profile change requires symphony update --agent'
    ) || return 1
  fi
  if [ "$agent" = claude ]; then claude_image_ready "$runtime" "$image"; fi
  [ "$state" = missing ] || "$runtime" rm "$name" >/dev/null
  "$runtime" volume create --label "com.symphony.storage=$storage_id" "$storage_id-workspaces" >/dev/null
  "$runtime" volume create --label "com.symphony.storage=$storage_id" "$storage_id-state" >/dev/null
  mkdir -p "$runner_home"
  if [ "$agent" = claude ]; then
    export SYMPHONY_GIT_TOKEN="$git_token"
    "$runtime" run --detach --restart unless-stopped --name "$name" \
      --label com.symphony.mode=listener --label "com.symphony.storage=$storage_id" \
      --label com.symphony.agent=claude --label "com.symphony.profile=$profile" \
      --label "com.symphony.image=$image_id" --label "com.symphony.port=$port" \
      --publish "127.0.0.1:$port:4010" \
      --read-only --cap-drop ALL --security-opt no-new-privileges --pids-limit 512 \
      --tmpfs /tmp:rw,nosuid,nodev,size=512m \
      --env-file "$project_env" --env SYMPHONY_GIT_TOKEN --env SYMPHONY_CONTAINERIZED=1 --env SYMPHONY_PORT=4010 \
      --mount "type=bind,source=$workflow,target=/etc/symphony/WORKFLOW.md,readonly" \
      --volume "$storage_id-workspaces:/workspaces" --volume "$storage_id-state:/var/lib/symphony" \
      --volume "$auth_volume:/home/claude" "$image_id" >/dev/null
    unset SYMPHONY_GIT_TOKEN
  else
  "$runtime" run --detach --restart unless-stopped --name "$name" \
    --label com.symphony.mode=listener \
    --label "com.symphony.storage=$storage_id" \
    --label com.symphony.agent=codex --label "com.symphony.image=$image_id" --label "com.symphony.port=$port" \
    --publish "127.0.0.1:$port:4010" \
    --env-file "$project_env" \
    --env SYMPHONY_CONTAINERIZED=1 \
    --env SYMPHONY_PORT=4010 \
    --volume "$workflow:/etc/symphony/WORKFLOW.md:ro" \
    --volume "$storage_id-workspaces:/workspaces" \
    --volume "$storage_id-state:/var/lib/symphony" \
    --volume "$codex_auth_volume:/root/.codex" \
    "$image_id" >/dev/null
  fi
  runner_write_metadata "$root" "$port" "$agent" "$image_id" "$profile"
  printf 'Symphony container: %s (http://127.0.0.1:%s)\n' "$name" "$port"
}

# The selected runtime cache is written atomically; the journal retains intent.
runner_write_metadata() (
  local root=$1 port=$2 agent=$3 image_id=$4 profile=$5 metadata_tmp
  umask 077
  metadata_tmp=$(mktemp "$runner_home/.runner.XXXXXX")
  cat >"$metadata_tmp" <<EOF
SYMPHONY_RUNNER_PORT=$port
SYMPHONY_RUNNER_AGENT=$agent
SYMPHONY_RUNNER_IMAGE_ID=$image_id
SYMPHONY_RUNNER_PROFILE=$profile
EOF
  mv "$metadata_tmp" "$(runner_env_file "$root")"
)

# Call only after updater ownership and expected-image checks have passed.
runner_record_observed_metadata() {
  local root=$1 runtime=$2 name=$3 agent image profile=none port
  port=$(runner_update_port "$root" "$runtime" "$name")
  image=$("$runtime" inspect --format '{{.Image}}' "$name")
  [ -n "$image" ] || die 'observed runner image is missing; updater refused'
  if runner_is_legacy "$runtime" "$name"; then agent=codex
  else agent=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.agent" }}' "$name"); validate_agent "$agent"; fi
  if [ "$agent" = claude ]; then
    profile=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.profile" }}' "$name")
    case "$profile" in ''|*[!a-f0-9]*) die 'observed native profile is invalid; updater refused' ;; esac
    [ "${#profile}" = 64 ] || die 'observed native profile is invalid; updater refused'
  fi
  runner_write_metadata "$root" "$port" "$agent" "$image" "$profile"
}

# Runner transitions are owned by the installed updater. Every failure retains
# volumes and leaves a drain marker; rollback is a separate updater operation.
runner_owned() {
  local root=$1 runtime=$2 name=$3 storage mode agent mounts
  storage=$(runner_storage_id "$root")
  [ "$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.storage" }}' "$name")" = "$storage" ] || die 'unknown or foreign runner storage; updater refused'
  mode=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.mode" }}' "$name")
  [ "$mode" = listener ] || die 'unqualified legacy runner; updater refused'
  agent=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.agent" }}' "$name")
  case "$agent" in
    ''|'<no value>')
      [ "$("$runtime" inspect --format '{{join .Config.Entrypoint " "}}' "$name")" = /usr/local/bin/symphony-runner ] || die 'unknown legacy entrypoint; updater refused'
      mounts=$("$runtime" inspect --format '{{range .Mounts}}{{println .Name .Destination}}{{end}}' "$name")
      printf '%s\n' "$mounts" | grep -Fxq -- "$codex_auth_volume /root/.codex" || die 'legacy Codex login mount differs; updater refused'
      mounts=$("$runtime" inspect --format '{{range .Mounts}}{{println .Source .Destination .RW}}{{end}}' "$name")
      printf '%s\n' "$mounts" | grep -Fxq -- "$root/WORKFLOW.md /etc/symphony/WORKFLOW.md false" || die 'legacy workflow mount differs; updater refused'
      runner_update_port "$root" "$runtime" "$name" >/dev/null
      ;;
    *) validate_agent "$agent" ;;
  esac
  mounts=$("$runtime" inspect --format '{{range .Mounts}}{{println .Name .Destination}}{{end}}' "$name")
  printf '%s\n' "$mounts" | grep -Fxq -- "$storage-workspaces /workspaces" || die 'workspace mount identity differs; updater refused'
  printf '%s\n' "$mounts" | grep -Fxq -- "$storage-state /var/lib/symphony" || die 'state mount identity differs; updater refused'
}

runner_is_legacy() {
  case "$("$1" inspect --format '{{ index .Config.Labels "com.symphony.agent" }}' "$2")" in
    ''|'<no value>') return 0 ;;
    *) return 1 ;;
  esac
}

runner_update_port() {
  local root=$1 runtime=$2 name=$3 port bindings
  if runner_is_legacy "$runtime" "$name"; then
    port=$(sed -n 's/^SYMPHONY_RUNNER_PORT=//p' "$(runner_env_file "$root")")
    bindings=$("$runtime" inspect --format '{{range (index .HostConfig.PortBindings "4010/tcp")}}{{println .HostIp .HostPort}}{{end}}' "$name")
    [ "$bindings" = "127.0.0.1 $port" ] || die 'legacy loopback port differs from metadata; updater refused'
  else
    port=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.port" }}' "$name")
  fi
  case "$port" in ''|*[!0-9]*) die 'unknown runner port; updater refused' ;; esac
  [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die 'invalid runner port; updater refused'
  printf '%s\n' "$port"
}

# Keep the guard inode: unlinking a locked file would allow a second updater
# to lock a different inode. flock is released when the updater and its children
# close FD 9, including on crashes; there is no separate owner publication.
runner_transition_lock() {
  local path=$1
  if [ -n "${runner_lock_path:-}" ]; then
    [ "$runner_lock_path" = "$path" ] || die 'updater already holds a different project lock'
    return
  fi
  [ ! -L "$path.guard" ] || die 'unsafe updater lock'
  [ ! -e "$path.guard" ] || [ -f "$path.guard" ] || die 'unsafe updater lock'
  exec 9>>"$path.guard"
  python3 - "$path" <<'PYLOCK'
import fcntl, os, pathlib, stat, sys

def refuse(message):
    sys.exit('symphony: ' + message)

info = os.fstat(9)
if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
    refuse('unknown or foreign updater lock; inspect it before recovery')
try:
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    refuse('another updater is active')

# Accept only a provably abandoned lock from the previous launcher. Preserve
# ownerless/foreign records for inspection rather than guessing their ownership.
path = pathlib.Path(sys.argv[1])
if path.is_symlink():
    refuse('unsafe updater lock')
if path.exists():
    owner = path / 'owner'
    if not path.is_dir() or path.stat().st_uid != os.geteuid() or owner.is_symlink() or not owner.is_file():
        refuse('updater lock has no verifiable owner; inspect it before recovery')
    pid = owner.read_text().strip()
    if not pid.isascii() or not pid.isdecimal() or int(pid) <= 0:
        refuse('invalid updater lock owner')
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        pass
    except (PermissionError, OverflowError):
        refuse('updater lock owner cannot be verified; inspect it before recovery')
    else:
        refuse('another updater is active')
    if set(path.iterdir()) != {owner}:
        refuse('unknown updater lock metadata; inspect it before recovery')
    owner.unlink()
    path.rmdir()
PYLOCK
  runner_lock_path=$path
}

runner_resume_when_ready() {
  local port=$1 legacy=${2:-false} prior=${3:-false} attempt data
  for attempt in $(seq 1 15); do
    if data=$(curl --fail --silent --max-time 3 --max-filesize 1048576 "http://127.0.0.1:$port/api/v1/state"); then
      if "$legacy"; then
        if printf '%s' "$data" | python3 -c 'import json,sys; s=json.load(sys.stdin); n=s.get("counts",{}).get("running"); sys.exit(0 if type(n) is int and n >= 0 and "error" not in s else 1)'; then return; fi
        sleep 1
        continue
      fi
      if runner_admission_ready "$data" "$prior"; then return; fi
      data=$(runner_control_request "$port" resume) || return 1
      if runner_admission_ready "$data"; then return; fi
      if "$prior"; then
        data=$(curl --fail --silent --max-time 3 --max-filesize 1048576 "http://127.0.0.1:$port/api/v1/state") || return 1
        runner_admission_ready "$data" true
        return $?
      fi
      return 1
    fi
    sleep 1
  done
  return 1
}

# State snapshots wrap admission in agent; control replies return it directly.
runner_admission_ready() {
  local outcome
  # Only a verified restored prior image may use the older provider-aware API.
  if [ "${2:-false}" = true ] && printf '%s' "$1" | python3 -c 'import json,sys; a=json.load(sys.stdin).get("agent",{}); sys.exit(0 if "admission" not in a and a.get("draining") is False and a.get("readiness",{}).get("ready") is True and a.get("pause","unknown") is None else 1)'; then
    printf 'Prior runner restored using its pre-admission API; native readiness passed with no retained pause.\n'
    return 0
  fi
  outcome=$(printf '%s' "$1" | python3 -c 'import json,sys; s=json.load(sys.stdin); a=s.get("agent",s); d=a.get("admission") or {}; print("operational" if a.get("draining") is False and d.get("ready") is True else "quota_paused" if a.get("draining") is False and d.get("ready") is False and d.get("reason")=="quota_exhausted" and type(d.get("retry_at")) is int else "unhealthy")') || return 1
  case "$outcome" in
    operational) return 0 ;;
    quota_paused) printf 'Runner resumed with dispatch intentionally paused until the recorded quota reset.\n'; return 0 ;;
    *) return 1 ;;
  esac
}

runner_control_request() {
  local port=$1 action=$2
  curl --fail --silent --show-error --max-time 45 --max-filesize 1048576 \
    -H 'x-symphony-control: 1' -H 'Content-Type: application/json' \
    -d '{}' "http://127.0.0.1:$port/api/v1/agent/$action"
}

runner_wait_idle() {
  local port=$1 attempt data
  for attempt in $(seq 1 30); do
    data=$(curl --fail --silent --show-error --max-time 5 --max-filesize 1048576 "http://127.0.0.1:$port/api/v1/state") || return 1
    if printf '%s' "$data" | python3 -c 'import json,sys; s=json.load(sys.stdin); sys.exit(0 if s.get("agent",{}).get("draining") is True and s.get("counts",{}).get("running") == 0 else 1)'; then return; fi
    sleep 1
  done
  die 'runner is still draining; active work was retained. Retry symphony update when idle'
}

runner_pause() {
  local root=$1 allow_legacy_stop=${2:-false} runtime name state port
  runtime=$(container_runtime); name=$(runner_id "$root"); state=$(runner_status "$root")
  [ "$state" != missing ] || die 'no qualified runner to pause'
  runner_owned "$root" "$runtime" "$name"
  if [ "$state" = true ]; then
    if runner_is_legacy "$runtime" "$name"; then
      "$allow_legacy_stop" || die 'legacy listener has no drain API; finish active work, then use symphony update --pause-runner before retrying --agent'
      # Only the explicit pause action may stop an old listener without a drain API.
      # Transition refuses a running legacy source before reaching this function.
      printf 'Legacy listener has no drain API; updater is stopping it gracefully. Retained work will resume after migration.\n'
      "$runtime" stop --time 30 "$name" >/dev/null
      return
    fi
    if [ "$("$runtime" inspect --format '{{.State.Restarting}}' "$name")" = true ] &&
       [ "$("$runtime" inspect --format '{{.State.Pid}}' "$name")" = 0 ]; then
      "$runtime" stop --time 30 "$name" >/dev/null
      printf 'Updater stopped an empty restarting container; retained work was not dispatched.\n'
      return
    fi
    port=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.port" }}' "$name")
    case "$port" in ''|*[!0-9]*) die 'unknown runner port; updater refused' ;; esac
    runner_control_request "$port" drain >/dev/null
    runner_wait_idle "$port"
    "$runtime" stop --time 30 "$name" >/dev/null
  fi
  printf 'Runner paused by updater; workspaces, state and native login retained.\n'
}

runner_finish_journal() {
  local journal=$1
  [ ! -e "$journal.complete" ] || die 'completed transition metadata already exists; inspect it before retrying'
  mv "$journal" "$journal.complete"
  rm -f "$journal.complete/image.next" "$journal.complete/previous.env.next"
  rm "$journal.complete/target" "$journal.complete/port" "$journal.complete/previous.env" "$journal.complete/image"
  rmdir "$journal.complete"
}

# Development retries follow the current checkout rather than a journal's old image.
# Commit the replacement image only after removing the verified old candidate.
# A crash before that commit is retryable: the retained backup is never removed.
runner_refresh_pending() {
  local root=$1 agent=$2 journal=$3 backup=$4 desired=$5 runtime name old replacement state previous
  runtime=$(container_runtime); name=$(runner_id "$root"); old=$(cat "$journal/image")
  if [ "$(runner_status "$root")" = true ] && ! "$runtime" inspect "$backup" >/dev/null 2>&1 &&
     runner_is_legacy "$runtime" "$name"; then
    die 'legacy listener has no drain API; finish active work, then use symphony update --pause-runner before retrying --agent'
  fi
  export SYMPHONY_RUNNER_IMAGE="$desired"
  runner_build_image "$agent"
  runner_doctor "$root" "$agent"
  replacement=$("$runtime" image inspect --format '{{.Id}}' "$desired")
  [ -n "$replacement" ] || die 'development candidate has no image identity; updater refused'
  if [ "$replacement" = "$old" ]; then return; fi

  state=$(runner_status "$root")
  if "$runtime" inspect "$backup" >/dev/null 2>&1; then
    runner_owned "$root" "$runtime" "$backup"
    [ "$("$runtime" inspect --format '{{.State.Running}}' "$backup")" = false ] || die 'prior runner is unexpectedly active; updater refused'
    if [ "$state" != missing ]; then
      runner_owned "$root" "$runtime" "$name"
      [ "$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.agent" }}' "$name")" = "$agent" ] || die 'candidate provider differs; updater refused'
      [ "$("$runtime" inspect --format '{{.Image}}' "$name")" = "$old" ] || die 'candidate image differs; updater refused'
      if [ "$state" = true ] &&
         "$runtime" exec "$name" sh -ceu 'test -f /var/lib/symphony/agent-upgrade-unresumed && test -f /var/lib/symphony/agent-draining'; then
        "$runtime" stop --time 30 "$name" >/dev/null
      else
        runner_pause "$root"
      fi
      "$runtime" rm "$name" >/dev/null
    fi
  else
    # Before the first rename, or after the previous candidate already committed,
    # the current qualified container becomes the rollback source for this image.
    runner_owned "$root" "$runtime" "$name"
    previous=$(sed -n 's/^SYMPHONY_RUNNER_IMAGE_ID=//p' "$journal/previous.env")
    state=$("$runtime" inspect --format '{{.Image}}' "$name")
    [ "$state" = "$old" ] || [ "$state" = "$previous" ] || die 'pending source image differs; updater refused'
    if [ "$state" = "$old" ] && [ "$state" != "$previous" ]; then
      runner_record_observed_metadata "$root" "$runtime" "$name"
      cp "$(runner_env_file "$root")" "$journal/previous.env.next"
      mv "$journal/previous.env.next" "$journal/previous.env"
    fi
  fi
  printf '%s\n' "$replacement" > "$journal/image.next"
  mv "$journal/image.next" "$journal/image"
  printf 'Refreshed pending development candidate: %s -> %s. Rollback source retained.\n' "$old" "$replacement"
}

# The caller has verified the retained source and that no candidate is active.
runner_prepare_storage() {
  local root=$1 runtime=$2 image=$3 agent=$4 new_candidate=$5 storage volume users uid=0
  validate_agent "$agent"
  if [ "$agent" = claude ]; then uid=11001; fi
  storage=$(runner_storage_id "$root")
  for volume in "$storage-workspaces" "$storage-state"; do
    users=$("$runtime" ps --filter "volume=$volume" --format '{{.ID}}')
    [ -z "$users" ] || die 'retained volume is in use by another container; updater refused'
  done
  "$runtime" run --rm --network none --read-only --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER \
    --security-opt no-new-privileges --user 0:0 --entrypoint sh \
    --volume "$storage-workspaces:/workspaces" --volume "$storage-state:/state" "$image" \
    -ceu 'if [ "$2" = true ]; then
        printf "draining\n" > /state/agent-draining
        printf "unresumed\n" > /state/agent-upgrade-unresumed
      fi
      chown -hR "$3:$3" /workspaces /state' sh "$agent" "$new_candidate" "$uid"
}

runner_transition() (
  local root=$1 agent=$2 development=${3:-false} runtime name id env_file journal backup candidate port=4010 state old_agent
  validate_agent "$agent"
  runtime=$(container_runtime); name=$(runner_id "$root"); id=$(project_id "$root")
  mkdir -p "$runner_home"
  journal="$runner_home/$id.transition"; backup="$name-before-update"; env_file=$(runner_env_file "$root")
  runner_transition_lock "$journal.lock"
  if [ -d "$journal.complete" ] && [ ! -L "$journal.complete" ]; then
    rm -f "$journal.complete/target" "$journal.complete/port" "$journal.complete/previous.env" "$journal.complete/image" \
      "$journal.complete/image.next" "$journal.complete/previous.env.next"
    rmdir "$journal.complete" || die 'unknown completed transition metadata; updater refused'
  fi
  candidate="$runtime_prefix-runner-$agent:$(source_revision)"
  export SYMPHONY_RUNNER_IMAGE="$candidate"
  if [ -d "$journal" ]; then
    [ "$(cat "$journal/target")" = "$agent" ] || die 'a different transition is pending; finish it or use symphony update --rollback-runner'
    if "$development"; then runner_refresh_pending "$root" "$agent" "$journal" "$backup" "$candidate"; fi
    candidate=$(cat "$journal/image"); export SYMPHONY_RUNNER_IMAGE="$candidate"
  else
    [ ! -e "$journal" ] || die 'invalid transition state; updater refused'
    [ "$(runner_status "$root")" != missing ] || die 'start a fresh project with symphony run --agent; no existing runner to transition'
    runner_owned "$root" "$runtime" "$name"
    if runner_is_legacy "$runtime" "$name" && [ "$(runner_status "$root")" = true ]; then
      die 'legacy listener has no drain API; finish active work, then use symphony update --pause-runner before retrying --agent'
    fi
    "$runtime" inspect "$backup" >/dev/null 2>&1 && die 'a retained prior runner exists; inspect it before another transition'
    [ -r "$env_file" ] || die 'runner metadata is missing; updater refused'
    port=$(runner_update_port "$root" "$runtime" "$name")
    runner_build_image "$agent"
    runner_doctor "$root" "$agent"
    local journal_tmp
    journal_tmp=$(mktemp -d "$runner_home/.transition.XXXXXX")
    cp "$env_file" "$journal_tmp/previous.env"
    if runner_is_legacy "$runtime" "$name"; then
      sed '/^SYMPHONY_RUNNER_IMAGE_ID=/d' "$env_file" >"$journal_tmp/previous.env"
      printf 'SYMPHONY_RUNNER_IMAGE_ID=%s\n' "$("$runtime" inspect --format '{{.Image}}' "$name")" >>"$journal_tmp/previous.env"
    fi
    printf '%s\n' "$agent" >"$journal_tmp/target"
    printf '%s\n' "$port" >"$journal_tmp/port"
    "$runtime" image inspect --format '{{.Id}}' "$candidate" >"$journal_tmp/image"
    mv "$journal_tmp" "$journal"
  fi
  port=$(cat "$journal/port")
  candidate=$(cat "$journal/image"); export SYMPHONY_RUNNER_IMAGE="$candidate"
  if ! "$runtime" inspect "$backup" >/dev/null 2>&1; then
    if [ "$(runner_status "$root")" = true ] &&
       [ "$("$runtime" inspect --format '{{.Image}}' "$name")" = "$("$runtime" image inspect --format '{{.Id}}' "$candidate")" ]; then
      runner_owned "$root" "$runtime" "$name"
      runner_resume_when_ready "$port" || die 'candidate recovery refused'
      runner_record_observed_metadata "$root" "$runtime" "$name"
      "$runtime" tag "$candidate" "$(runner_local_image "$agent")"
      runner_finish_journal "$journal"
      printf 'Previously completed runner transition recovered.\n'
      return
    fi
    runner_pause "$root"
    "$runtime" rename "$name" "$backup"
  fi
  runner_owned "$root" "$runtime" "$backup"
  [ "$("$runtime" inspect --format '{{.State.Running}}' "$backup")" = false ] || die 'prior runner is unexpectedly active; updater refused'
  if [ "$(runner_status "$root")" = missing ]; then
    # Keep a newly created candidate idle until readiness has been verified.
    runner_prepare_storage "$root" "$runtime" "$candidate" "$agent" true
    runner_start "$root" "$port" "$agent" update
  else
    runner_owned "$root" "$runtime" "$name"
    [ "$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.agent" }}' "$name")" = "$agent" ] || die 'candidate provider differs; updater refused'
    [ "$("$runtime" inspect --format '{{.Image}}' "$name")" = "$("$runtime" image inspect --format '{{.Id}}' "$candidate")" ] || die 'candidate image differs; updater refused'
  fi
  runner_resume_when_ready "$port" || die 'candidate is not ready; retained prior runner can be restored with symphony update --rollback-runner'
  runner_record_observed_metadata "$root" "$runtime" "$name"
  "$runtime" tag "$candidate" "$(runner_local_image "$agent")"
  "$runtime" rm "$backup" >/dev/null
  runner_finish_journal "$journal"
  printf 'Runner transition complete: %s. Workspaces and logs retained.\n' "$agent"
)

runner_rollback() (
  local root=$1 runtime name backup id journal port previous_agent previous_image state
  runtime=$(container_runtime); name=$(runner_id "$root"); backup="$name-before-update"; id=$(project_id "$root")
  journal="$runner_home/$id.transition"
  [ -d "$journal" ] && [ -f "$journal/previous.env" ] || die 'no retained transition to roll back'
  runner_transition_lock "$journal.lock"
  if [ -d "$journal.complete" ] && [ ! -L "$journal.complete" ]; then
    rm -f "$journal.complete/target" "$journal.complete/port" "$journal.complete/previous.env" "$journal.complete/image" \
      "$journal.complete/image.next" "$journal.complete/previous.env.next"
    rmdir "$journal.complete" || die 'unknown completed transition metadata; updater refused'
  fi
  if "$runtime" inspect "$backup" >/dev/null 2>&1; then
    runner_owned "$root" "$runtime" "$backup"
    [ "$("$runtime" inspect --format '{{.State.Running}}' "$backup")" = false ] || die 'prior runner is unexpectedly active; rollback refused'
    if [ "$(runner_status "$root")" != missing ]; then
      runner_owned "$root" "$runtime" "$name"
      [ "$("$runtime" inspect --format '{{.Image}}' "$name")" = "$(cat "$journal/image")" ] || die 'candidate image differs; rollback refused'
      [ "$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.agent" }}' "$name")" = "$(cat "$journal/target")" ] || die 'candidate provider differs; rollback refused'
      if [ "$(runner_status "$root")" = true ] &&
         "$runtime" exec "$name" sh -ceu 'test -f /var/lib/symphony/agent-upgrade-unresumed && test -f /var/lib/symphony/agent-draining'; then
        "$runtime" stop --time 30 "$name" >/dev/null
      else
        runner_pause "$root"
      fi
      "$runtime" rm "$name" >/dev/null
    fi
    "$runtime" rename "$backup" "$name"
  else
    runner_owned "$root" "$runtime" "$name"
    previous_image=$(sed -n 's/^SYMPHONY_RUNNER_IMAGE_ID=//p' "$journal/previous.env")
    [ -n "$previous_image" ] && [ "$("$runtime" inspect --format '{{.Image}}' "$name")" = "$previous_image" ] || die 'prior container cannot be verified; rollback refused'
  fi
  previous_image=$("$runtime" inspect --format '{{.Image}}' "$name")
  if runner_is_legacy "$runtime" "$name"; then previous_agent=codex
  else previous_agent=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.agent" }}' "$name"); fi
  state=$(runner_status "$root")
  if [ "$state" != true ]; then
    [ "$("$runtime" inspect --format '{{.State.Running}}' "$name")" = false ] || die 'prior runner is unexpectedly active; rollback refused'
    runner_prepare_storage "$root" "$runtime" "$previous_image" "$previous_agent" false
  fi
  runner_record_observed_metadata "$root" "$runtime" "$name"
  if [ "$state" != true ]; then "$runtime" start "$name" >/dev/null; fi
  port=$(cat "$journal/port")
  if runner_is_legacy "$runtime" "$name"; then
    # The previous API has no agent readiness or resume endpoint.
    runner_resume_when_ready "$port" true || die 'prior legacy runner retained but not ready; retry rollback when healthy'
  else
    runner_resume_when_ready "$port" false true || die 'prior runner retained but not ready; repair authentication then retry recovery'
  fi
  "$runtime" tag "$previous_image" "$(runner_local_image "$previous_agent")"
  runner_finish_journal "$journal"
  printf 'Prior runner restored; workspaces, unpushed commits and logs retained.\n'
)

runner_stop() {
  local root=$1 runtime name storage_id
  runtime=$(container_runtime); name=$(runner_id "$root")
  if "$runtime" inspect "$name" >/dev/null 2>&1; then
    storage_id=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.storage" }}' "$name")
    [ "$storage_id" = "$(runner_storage_id "$root")" ] || die "container $name has unknown or foreign storage; refusing to stop it"
    "$runtime" stop --time 30 "$name" >/dev/null
  fi
  printf 'Runner stopped: %s\nContainer, workspace and log volumes retained for restart or updater transition.\n' "$name"
}

runner_doctor() {
  local root=$1 agent=${2:-codex} runtime image
  validate_agent "$agent"
  runtime=$(container_runtime); image=$(runner_image "$agent")
  if [ "$agent" = claude ]; then claude_auth check
  else auth_codex_check; fi
  "$runtime" run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges \
    --tmpfs /tmp:rw,exec,nosuid,nodev,size=32m --entrypoint sh "$image" -ceu '
    set -eu
    workspace=$(mktemp -d /tmp/symphony-git-preflight.XXXXXX)
    trap "rm -rf \"$workspace\"" EXIT
    git -C "$workspace" init -q
    git -C "$workspace" config user.name Symphony
    git -C "$workspace" config user.email symphony@localhost
    git -C "$workspace" switch -q -c preflight
    printf ready > "$workspace/READY"
    git -C "$workspace" add READY
    git -C "$workspace" commit -qm preflight
  '
  printf 'Native authentication/policy and isolated Git preflight passed. No listener or model request was started.\n'
}

runner() {
  local command=${1:-} root agent=codex
  root=$(repo_root)
  case "$command" in
    start) runner_start "$root" "${2:-4010}" ;;
    stop) runner_stop "$root" ;;
    status) runner_report "$root" ;;
    doctor)
      shift
      if [ "$#" -gt 0 ]; then [ "$#" = 2 ] && [ "$1" = --agent ] || die 'Usage: symphony runner doctor [--agent codex|claude]'; agent=$2; fi
      validate_agent "$agent"; runner_doctor "$root" "$agent" ;;
    logs)
      runtime=$(container_runtime)
      [ "$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.storage" }}' "$(runner_id "$root")")" = "$(runner_storage_id "$root")" ] || die 'unknown or foreign runner; logs refused'
      "$runtime" logs --follow "$(runner_id "$root")" ;;
    drain|resume|recheck)
      runtime=$(container_runtime)
      runner_owned "$root" "$runtime" "$(runner_id "$root")"
      port=$("$runtime" inspect --format '{{ index .Config.Labels "com.symphony.port" }}' "$(runner_id "$root")")
      runner_control_request "$port" "$command" ;;
    --help|-h|'') printf 'Usage: symphony runner start [PORT]|stop|status|doctor|logs\n' ;;
    *) die "unknown runner command: $command" ;;
  esac
}

run() {
  local root id env_file workflow runtime host=false port=4010 agent=codex agent_seen=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --host) host=true; shift ;;
      --isolated) shift ;;
      --agent)
        [ "$#" -ge 2 ] || die '--agent requires codex or claude'
        ! "$agent_seen" || die '--agent may be specified only once'
        agent=$2; validate_agent "$agent"; agent_seen=true; shift 2 ;;
      --port) [ "$#" -ge 2 ] || die '--port requires a value'; port=$2; shift 2 ;;
      *) die "unknown run option: $1" ;;
    esac
  done
  case "$port" in ''|*[!0-9]*) die '--port requires an integer' ;; esac
  [ "$port" -le 65535 ] || die 'port must not exceed 65535'
  if "$host" && [ "$agent" = claude ]; then die 'Claude host/SSH execution is unsupported; use the isolated runner'; fi
  root=$(repo_root); id=$(project_id "$root")
  env_file="$config_home/projects/$id.env"; workflow="$root/WORKFLOW.md"
  [ -r "$env_file" ] || die "missing credentials file: $env_file"
  [ -f "$workflow" ] || die "missing workflow: $workflow"
  if ! "$host"; then
    runner_start "$root" "$port" "$agent"
    runner_report "$root"
    return
  fi
  runtime_ready || die 'host runtime is not ready; run symphony setup'
  set -a; . "$env_file"; set +a
  runtime="$symphony_home/elixir/bin/symphony"
  exec mise exec -C "$symphony_home/elixir" -- "$runtime" \
    --i-understand-that-this-will-be-running-without-the-usual-guardrails --agent codex --port "$port" "$workflow" "$@"
}

case "${1:-}" in
  --version) printf '{"mode":"cli","source_revision":"%s","source_state":"%s"}\n' "$(source_revision)" "$(source_state)" ;;
  --help|-h|'') usage ;;
  install) shift; install "$@" ;;
  setup) shift; setup "$@" ;;
  doctor) shift; doctor "$@" ;;
  update) shift; update "$@" ;;
  init) shift; init "$@" ;;
  skill) shift; skill "$@" ;;
  project) shift; project "$@" ;;
  auth) shift; auth "$@" ;;
  runner) shift; runner "$@" ;;
  run) shift; run "$@" ;;
  *) usage >&2; exit 2 ;;
esac
