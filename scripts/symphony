#!/usr/bin/env bash
# Stable, checkout-backed command for a local Symphony runtime.
set -euo pipefail

die() { printf 'symphony: %s\n' "$*" >&2; exit 1; }

script_path=${BASH_SOURCE[0]}
while [ -L "$script_path" ]; do
  link=$(readlink "$script_path")
  case "$link" in
    /*) script_path=$link ;;
    *) script_path=$(cd "$(dirname "$script_path")" && cd "$(dirname "$link")" && pwd)/$(basename "$link") ;;
  esac
done
script_dir=$(cd "$(dirname "$script_path")" && pwd)
symphony_home=${SYMPHONY_HOME:-$(cd "$script_dir/.." && pwd)}
config_home=${SYMPHONY_CONFIG_HOME:-"${XDG_CONFIG_HOME:-$HOME/.config}/symphony"}
bin_dir=${SYMPHONY_BIN_DIR:-"$HOME/.local/bin"}
skills_dir=${SYMPHONY_SKILLS_DIR:-"${CODEX_HOME:-$HOME/.codex}/skills"}
runner_home=${SYMPHONY_RUNNER_HOME:-"$config_home/runners"}
secrets_home=${SYMPHONY_SECRETS_HOME:-"$config_home/secrets"}
managed_skills=(commit push pull linear land)

source_revision() { git -C "$symphony_home" rev-parse HEAD 2>/dev/null || printf 'unknown\n'; }

source_state() {
  if [ ! -d "$symphony_home/.git" ]; then
    printf 'unknown\n'
  elif [ -n "$(git -C "$symphony_home" status --porcelain 2>/dev/null)" ]; then
    printf 'dirty\n'
  else
    printf 'clean\n'
  fi
}

bool() { "$1" && printf 'true' || printf 'false'; }

ensure_launcher_link() {
  local source=$1 target=$2
  source=$(cd "$(dirname "$source")" && pwd)/$(basename "$source")
  mkdir -p "$(dirname "$target")"

  if [ -L "$target" ]; then
    [ "$(readlink "$target")" = "$source" ] || die "refusing to replace existing symlink: $target"
    printf 'Launcher: unchanged (%s)\n' "$target"
    return
  fi
  [ ! -e "$target" ] || die "refusing to replace existing path: $target"
  ln -s "$source" "$target"
  printf 'Launcher: created (%s)\n' "$target"
}

tool_available() { command -v "$1" >/dev/null 2>&1; }

required_tools() {
  local tool missing=0
  for tool in git mise gh codex; do
    if ! tool_available "$tool"; then
      printf 'Missing prerequisite: %s\n' "$tool" >&2
      missing=1
    fi
  done
  return "$missing"
}

runtime_ready() {
  tool_available mise && mise -C "$symphony_home/elixir" exec -- erl -noshell -eval 'halt().' >/dev/null 2>&1
}

install_prerequisites() {
  case "$(uname -s)" in
    Darwin)
      tool_available git || {
        xcode-select --install || true
        die 'install the Xcode Command Line Tools, then rerun symphony setup'
      }
      tool_available brew || die 'install Homebrew first: https://brew.sh'
      tool_available mise || brew install mise
      tool_available gh || brew install gh
      if ! tool_available codex; then
        tool_available npm || brew install node
        npm install -g @openai/codex@latest
      fi
      ;;
    *)
      die 'automatic prerequisite installation currently supports macOS only; install git, mise, gh, and Codex, then rerun symphony setup'
      ;;
  esac
}

repo_root() { git rev-parse --show-toplevel 2>/dev/null || die 'run this command inside a Git repository'; }

project_id() {
  local remote name
  remote=$(git -C "$1" remote get-url origin 2>/dev/null || true)
  name=$(basename "${remote:-$1}" .git | tr -cs '[:alnum:]._' '-' | sed 's/-*$//')
  printf '%s\n' "$name"
}

skill_name() { printf 'symphony-%s\n' "$1"; }

skill_source() { printf '%s/.codex/skills/%s\n' "$symphony_home" "$1"; }

global_skill_path() { printf '%s/%s\n' "$skills_dir" "$(skill_name "$1")"; }

managed_skill() {
  local skill
  for skill in "${managed_skills[@]}"; do [ "$skill" = "$1" ] && return 0; done
  return 1
}

ensure_global_skills() {
  local skill source target
  for skill in "${managed_skills[@]}"; do
    source=$(skill_source "$skill")
    target=$(global_skill_path "$skill")
    [ -d "$source" ] || die "missing bundled skill: $skill"
    if [ -L "$target" ]; then
      [ "$(readlink "$target")" = "$source" ] || die "refusing to replace existing global skill link: $target"
    elif [ -e "$target" ]; then
      die "refusing to replace existing global skill: $target"
    fi
  done
  mkdir -p "$skills_dir"
  for skill in "${managed_skills[@]}"; do
    source=$(skill_source "$skill")
    target=$(global_skill_path "$skill")
    [ -L "$target" ] || ln -s "$source" "$target"
  done
  printf 'Skills: linked globally (%s)\n' "$skills_dir"
}

global_skills_ready() {
  local skill source target
  for skill in "${managed_skills[@]}"; do
    source=$(skill_source "$skill")
    target=$(global_skill_path "$skill")
    [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ] || return 1
  done
}

usage() {
  cat <<'EOF'
Usage:
  symphony --version
  symphony install [--bin-dir PATH] [--config-dir PATH] [--skills-dir PATH]
  symphony setup [--install-prerequisites]
  symphony doctor [--json] [--bin-dir PATH] [--config-dir PATH] [--skills-dir PATH]
  symphony update [--bin-dir PATH] [--config-dir PATH] [--skills-dir PATH]
  symphony init --linear-project SLUG [--local-skill NAME]...
  symphony skill override NAME
  symphony skill migrate-local NAME
  symphony skill use-global NAME
  symphony project doctor [--json]
  symphony auth codex {set|check|remove}
  symphony runner start|stop|status|doctor
  symphony run [--isolated] [--port PORT]

Run this command from a clean, stable Symphony checkout such as ~/src/symphony.
`install` only links the command and creates protected configuration storage.
`setup` deliberately installs or repairs prerequisites and the pinned mise runtime.
`update` fast-forwards the tracked main branch and keeps its global skills linked
to the stable runtime; it never overwrites project files.

Use SYMPHONY_HOME when this script is copied outside its checkout. Set
SYMPHONY_BIN_DIR, SYMPHONY_CONFIG_HOME, and SYMPHONY_SKILLS_DIR to use alternate
locations. Symphony installs namespaced global skills, such as `symphony-land`,
to avoid affecting unrelated Codex work. Use `skill override` only when a
repository genuinely needs to customize one of them. `project doctor` is
read-only and identifies legacy project configuration safely.

Credentials created by init are stored outside the repository at:
  $SYMPHONY_CONFIG_HOME/projects/<repository>.env

GitHub tokens should be fine-grained and repository-scoped. Grant Contents and
Pull requests: Read and write; grant Issues or Workflows only when needed.

An isolated runner needs a dedicated Codex access token. Store it outside the
repository with `symphony auth codex set --from-stdin`; never mount a host
Codex login or add the token to a project .env file.

`symphony run --isolated` uses a Docker- or Podman-compatible SSH worker. The
worker is the only process given unrestricted Git metadata access; it owns the
ticket workspaces and does not mount the developer checkout, home directory,
or host Codex login.
EOF
}

install() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --bin-dir) [ "$#" -ge 2 ] || die '--bin-dir requires a path'; bin_dir=$2; shift 2 ;;
      --config-dir) [ "$#" -ge 2 ] || die '--config-dir requires a path'; config_home=$2; shift 2 ;;
      --skills-dir) [ "$#" -ge 2 ] || die '--skills-dir requires a path'; skills_dir=$2; shift 2 ;;
      --help|-h) printf 'Usage: symphony install [--bin-dir PATH] [--config-dir PATH] [--skills-dir PATH]\n'; return ;;
      *) die "unknown install option: $1" ;;
    esac
  done
  ensure_launcher_link "$symphony_home/scripts/symphony" "$bin_dir/symphony"
  (umask 077; mkdir -p "$config_home/projects")
  ensure_global_skills
  printf 'Runtime: %s\nConfiguration: %s\nNext: run symphony setup, then symphony init inside a Git repository.\n' \
    "$symphony_home" "$config_home"
}

setup() {
  local install_missing=false
  case "${1:-}" in
    '') ;;
    --install-prerequisites) install_missing=true ;;
    --help|-h) printf 'Usage: symphony setup [--install-prerequisites]\n'; return ;;
    *) die "unknown setup option: $1" ;;
  esac

  if ! required_tools; then
    "$install_missing" || die 'rerun with --install-prerequisites after reviewing the changes it will make'
    install_prerequisites
    required_tools || die 'a prerequisite is still missing after installation'
  fi
  mise -C "$symphony_home/elixir" install
  runtime_ready || die 'mise completed but the Symphony Erlang runtime is unavailable'
  mise -C "$symphony_home/elixir" exec -- mix setup
  mise -C "$symphony_home/elixir" exec -- mix build
  [ -x "$symphony_home/elixir/bin/symphony" ] || die 'runtime build completed without creating elixir/bin/symphony'
  printf 'Runtime setup complete: %s\n' "$symphony_home/elixir"
}

update() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --bin-dir|--config-dir|--skills-dir)
        [ "$#" -ge 2 ] || die "$1 requires a path"
        if [ "$1" = --bin-dir ]; then bin_dir=$2; elif [ "$1" = --config-dir ]; then config_home=$2; else skills_dir=$2; fi
        shift 2 ;;
      --help|-h) printf 'Usage: symphony update [--bin-dir PATH] [--config-dir PATH] [--skills-dir PATH]\n'; return ;;
      *) die "unknown update option: $1" ;;
    esac
  done

  [ -d "$symphony_home/.git" ] || die "Symphony source is not a Git checkout: $symphony_home"
  [ -z "$(git -C "$symphony_home" status --porcelain)" ] || die "Symphony source has uncommitted changes; update it manually: $symphony_home"
  local branch upstream remote before after
  branch=$(git -C "$symphony_home" branch --show-current)
  [ "$branch" = main ] || die "update requires main, not ${branch:-detached HEAD}"
  upstream=$(git -C "$symphony_home" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null) || die 'main has no upstream; configure it before updating'
  remote=${upstream%%/*}
  before=$(git -C "$symphony_home" rev-parse HEAD)
  git -C "$symphony_home" fetch "$remote"
  git -C "$symphony_home" merge --ff-only "$upstream"
  after=$(git -C "$symphony_home" rev-parse HEAD)
  [ -z "$(git -C "$symphony_home" status --porcelain)" ] || die 'update left unexpected working-tree changes'
  "$symphony_home/scripts/symphony" install --bin-dir "$bin_dir" --config-dir "$config_home" --skills-dir "$skills_dir"
  if [ "$before" != "$after" ]; then
    "$symphony_home/scripts/symphony" setup
  fi
  printf 'Updated: %s -> %s\n' "$before" "$after"
}

doctor() {
  local json=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) json=true; shift ;;
      --bin-dir|--config-dir|--skills-dir)
        [ "$#" -ge 2 ] || die "$1 requires a path"
        if [ "$1" = --bin-dir ]; then bin_dir=$2; elif [ "$1" = --config-dir ]; then config_home=$2; else skills_dir=$2; fi
        shift 2 ;;
      --help|-h) printf 'Usage: symphony doctor [--json] [--bin-dir PATH] [--config-dir PATH] [--skills-dir PATH]\n'; return ;;
      *) die "unknown doctor option: $1" ;;
    esac
  done

  local git_ok mise_ok gh_ok codex_ok runtime_ok launcher_ok source_ok skills_ok ready=true
  git_ok=false; tool_available git && git_ok=true
  mise_ok=false; tool_available mise && mise_ok=true
  gh_ok=false; tool_available gh && gh_ok=true
  codex_ok=false; tool_available codex && codex_ok=true
  runtime_ok=false; runtime_ready && runtime_ok=true
  launcher_ok=false; [ -L "$bin_dir/symphony" ] && [ "$(readlink "$bin_dir/symphony")" = "$symphony_home/scripts/symphony" ] && launcher_ok=true
  source_ok=false; [ -x "$symphony_home/elixir/bin/symphony" ] && source_ok=true
  skills_ok=false; global_skills_ready && skills_ok=true
  "$git_ok" && "$mise_ok" && "$gh_ok" && "$codex_ok" && "$runtime_ok" && "$launcher_ok" && "$source_ok" && "$skills_ok" || ready=false

  if "$json"; then
    printf '{"mode":"doctor","ready":%s,"source_revision":"%s","source_state":"%s","checks":{"source":%s,"launcher":%s,"skills":%s,"git":%s,"mise":%s,"gh":%s,"codex":%s,"runtime":%s}}\n' \
      "$(bool "$ready")" "$(source_revision)" "$(source_state)" "$(bool "$source_ok")" "$(bool "$launcher_ok")" \
      "$(bool "$skills_ok")" "$(bool "$git_ok")" "$(bool "$mise_ok")" "$(bool "$gh_ok")" "$(bool "$codex_ok")" "$(bool "$runtime_ok")"
  else
    printf 'Symphony %s (%s)\n' "$(source_revision)" "$(source_state)"
    printf 'source=%s launcher=%s skills=%s git=%s mise=%s gh=%s codex=%s runtime=%s\n' \
      "$source_ok" "$launcher_ok" "$skills_ok" "$git_ok" "$mise_ok" "$gh_ok" "$codex_ok" "$runtime_ok"
    "$ready" && printf 'Ready.\n' || printf 'Not ready. Run symphony install and symphony setup as needed.\n' >&2
  fi
  "$ready"
}

record_local_override() {
  local root=$1 skill=$2 origin=$3 manifest
  manifest="$root/.codex/symphony-skill-overrides.yml"
  if [ ! -e "$manifest" ]; then
    cat >"$manifest" <<'EOF'
# Local skills in this file deliberately shadow Symphony's global skills.
# They stop receiving runtime updates until this override is removed.
overrides:
EOF
  fi
  printf '  - name: %s\n    source: %s\n    source_revision: %s\n' \
    "$(skill_name "$skill")" "$origin" "$(source_revision)" >>"$manifest"
}

remove_override_record() {
  local root=$1 skill=$2 manifest temporary name
  manifest="$root/.codex/symphony-skill-overrides.yml"
  [ -f "$manifest" ] || return 0
  name=$(skill_name "$skill")
  temporary=$(mktemp "${TMPDIR:-/tmp}/symphony-overrides.XXXXXX")
  awk -v name="$name" '
    $0 == "  - name: " name { skip = 1; next }
    skip && /^    source: / { next }
    skip && /^    source_revision: / { skip = 0; next }
    { print }
  ' "$manifest" >"$temporary"
  mv "$temporary" "$manifest"
}

create_local_override() {
  local root=$1 skill=$2 source target
  managed_skill "$skill" || die "unknown managed skill: $skill"
  source=$(skill_source "$skill")
  target="$root/.codex/skills/$(skill_name "$skill")"
  [ -d "$source" ] || die "missing bundled skill: $skill"
  [ ! -e "$target" ] || die "local override already exists: $target"
  mkdir -p "$(dirname "$target")"
  cp -R "$source" "$target"
  record_local_override "$root" "$skill" 'global'
  printf 'Local skill override: %s\n' "$target"
}

set_skill_name() {
  local directory=$1 name=$2 temporary
  temporary=$(mktemp "${TMPDIR:-/tmp}/symphony-skill.XXXXXX")
  awk -v name="$name" '
    !updated && /^name: / { print "name: " name; updated = 1; next }
    { print }
  ' "$directory/SKILL.md" >"$temporary"
  mv "$temporary" "$directory/SKILL.md"
}

migrate_legacy_skill() {
  local root=$1 skill=$2 source target
  managed_skill "$skill" || die "unknown managed skill: $skill"
  source="$root/.codex/skills/$skill"
  target="$root/.codex/skills/$(skill_name "$skill")"
  [ -d "$source" ] || die "legacy local skill is missing: $source"
  [ ! -e "$target" ] || die "local override already exists: $target"
  mkdir -p "$(dirname "$target")"
  cp -R "$source" "$target"
  set_skill_name "$target" "$(skill_name "$skill")"
  record_local_override "$root" "$skill" "legacy:$source"
  printf 'Legacy skill preserved as local override: %s\nOriginal preserved: %s\n' "$target" "$source"
}

use_global_skill() {
  local root=$1 skill=$2 target backup
  managed_skill "$skill" || die "unknown managed skill: $skill"
  target="$root/.codex/skills/$(skill_name "$skill")"
  [ -d "$target" ] || die "local override is missing: $target"
  backup="$root/.codex/symphony-skill-backups/$(date +%Y%m%d%H%M%S)-$(skill_name "$skill")"
  [ ! -e "$backup" ] || die "refusing to replace existing backup: $backup"
  mkdir -p "$(dirname "$backup")"
  mv "$target" "$backup"
  remove_override_record "$root" "$skill"
  printf 'Global skill restored: %s\nLocal override backed up: %s\n' "$(global_skill_path "$skill")" "$backup"
}

init() {
  local slug='' root id remote workflow env_file skill
  local -a local_skills
  local_skills=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --linear-project) [ "$#" -ge 2 ] || die '--linear-project requires a slug'; slug=$2; shift 2 ;;
      --local-skill) [ "$#" -ge 2 ] || die '--local-skill requires a name'; local_skills+=("$2"); shift 2 ;;
      --help|-h) printf 'Usage: symphony init --linear-project SLUG [--local-skill NAME]...\n'; return ;;
      *) die "unknown init option: $1" ;;
    esac
  done
  [ -n "$slug" ] || die 'init requires --linear-project <slug>'
  global_skills_ready || ensure_global_skills
  root=$(repo_root)
  id=$(project_id "$root")
  remote=$(git -C "$root" remote get-url origin 2>/dev/null || die 'the repository needs an origin remote')
  workflow="$root/WORKFLOW.md"
  env_file="$config_home/projects/$id.env"

  (umask 077; mkdir -p "$(dirname "$env_file")")
  if [ ! -e "$env_file" ]; then (umask 077; cat >"$env_file" <<'EOF'
# Linear: Settings → Security & access → Personal API keys
LINEAR_API_KEY=
# GitHub: fine-grained, repository-scoped token. See `symphony --help`.
GH_TOKEN=
EOF
); fi

  if [ ! -e "$workflow" ]; then cat >"$workflow" <<EOF
---
tracker:
  kind: linear
  provider:
    project_slug: "$slug"
    api_key: \$LINEAR_API_KEY
  required_labels: []
  active_states: ["Todo", "In Progress", "Merging", "Rework"]
  terminal_states: ["Closed", "Cancelled", "Canceled", "Duplicate", "Done"]
polling:
  interval_ms: 5000
workspace:
  root: ~/.local/share/symphony/workspaces/$id
hooks:
  after_create: |
    git clone --depth 1 "$remote" .
  before_remove: |
    git clean -ffdqx
agent:
  max_concurrent_agents: 10
  max_turns: 20
codex:
  command: codex --config shell_environment_policy.inherit=all app-server
  approval_policy: never
  thread_sandbox: workspace-write
  live_max_total_tokens: 500000
  live_max_turns: 5
  turn_sandbox_policy:
    type: workspaceWrite
    networkAccess: true
---

EOF
    printf '\nRepository: %s\nRemote: %s\n\n' "$id" "$remote" >>"$workflow"
    awk 'BEGIN { delimiters = 0 } /^---$/ { delimiters++; next } delimiters >= 2 { print }' "$symphony_home/elixir/WORKFLOW.md" >>"$workflow"
  else
    printf 'Workflow: preserved (%s)\n' "$workflow"
  fi

  if [ "${#local_skills[@]}" -gt 0 ]; then
    for skill in "${local_skills[@]}"; do create_local_override "$root" "$skill"; done
  fi
  printf 'Project: initialized (%s)\nSkills: global (use --local-skill only for deliberate overrides)\nCredentials: %s\nNext: fill credentials, configure a dedicated Codex token with symphony auth codex set --from-stdin, then run symphony run\n' "$workflow" "$env_file"
}

skill() {
  local action=${1:-} name=${2:-}
  case "$action" in
    override|migrate-local|use-global) ;;
    *) printf 'Usage: symphony skill {override|migrate-local|use-global} NAME\n' >&2; return 2 ;;
  esac
  [ -n "$name" ] || die "skill $action requires a skill name"
  global_skills_ready || die 'global Symphony skills are missing; run symphony install first'
  case "$action" in
    override) create_local_override "$(repo_root)" "$name" ;;
    migrate-local) migrate_legacy_skill "$(repo_root)" "$name" ;;
    use-global) use_global_skill "$(repo_root)" "$name" ;;
  esac
}

project_doctor() {
  local json=$1 root id workflow env_file legacy_manifest legacy_count=0 override_count=0 legacy_refs=false wrapper=false skill
  root=$(repo_root)
  id=$(project_id "$root")
  workflow="$root/WORKFLOW.md"
  env_file="$config_home/projects/$id.env"
  legacy_manifest="$root/.codex/symphony-skills.yml"
  for skill in "${managed_skills[@]}"; do
    [ -d "$root/.codex/skills/$skill" ] && legacy_count=$((legacy_count + 1))
    [ -d "$root/.codex/skills/$(skill_name "$skill")" ] && override_count=$((override_count + 1))
  done
  [ -e "$root/script/symphony" ] && wrapper=true
  if [ -f "$workflow" ] && grep -Eq '(`(linear|commit|push|pull|land)`|\.codex/skills/(commit|push|pull|linear|land))' "$workflow"; then legacy_refs=true; fi

  if "$json"; then
    printf '{"mode":"project-doctor","workflow":%s,"credentials":%s,"global_skills":%s,"legacy_manifest":%s,"legacy_skill_count":%s,"local_override_count":%s,"legacy_workflow_references":%s,"legacy_wrapper":%s}\n' \
      "$(bool "$( [ -f "$workflow" ] && printf true || printf false )")" \
      "$(bool "$( [ -f "$env_file" ] && printf true || printf false )")" \
      "$(bool "$( global_skills_ready && printf true || printf false )")" \
      "$(bool "$( [ -f "$legacy_manifest" ] && printf true || printf false )")" \
      "$legacy_count" "$override_count" "$(bool "$legacy_refs")" "$(bool "$wrapper")"
    return
  fi

  printf 'Project: %s\nWorkflow: %s\nCredentials: %s\nGlobal skills: %s\n' \
    "$root" "$([ -f "$workflow" ] && printf present || printf missing)" \
    "$([ -f "$env_file" ] && printf present || printf missing)" \
    "$(global_skills_ready && printf ready || printf missing)"
  printf 'Legacy copied skills: %s\nLocal namespaced overrides: %s\nLegacy skill manifest: %s\nLegacy wrapper: %s\nLegacy workflow references: %s\n' \
    "$legacy_count" "$override_count" "$([ -f "$legacy_manifest" ] && printf present || printf absent)" "$wrapper" "$legacy_refs"
  if [ "$legacy_count" -gt 0 ]; then
    printf '\nLegacy skills are preserved and are not changed automatically. If a skill contains intentional team changes, preserve it with:\n  symphony skill migrate-local NAME\nThis creates a namespaced override and preserves the original; review cross-skill references afterward.\n'
  fi
  if "$legacy_refs"; then
    printf '\nWORKFLOW.md still names legacy local-skill paths. It is preserved; review it and change only the intended references to the namespaced global skill names.\n'
  fi
  if "$wrapper"; then
    printf '\nThe legacy script/symphony wrapper is redundant. Keep or remove it through the repository’s normal review process.\n'
  fi
}

project() {
  local command=${1:-} json=false
  [ "$command" = doctor ] || { printf 'Usage: symphony project doctor [--json]\n' >&2; return 2; }
  case "${2:-}" in
    '') ;;
    --json) json=true ;;
    *) die "unknown project doctor option: $2" ;;
  esac
  project_doctor "$json"
}

container_runtime() {
  local candidate
  if [ -n "${SYMPHONY_CONTAINER_RUNTIME:-}" ]; then
    tool_available "$SYMPHONY_CONTAINER_RUNTIME" || die "container runtime is unavailable: $SYMPHONY_CONTAINER_RUNTIME"
    printf '%s\n' "$SYMPHONY_CONTAINER_RUNTIME"
    return
  fi
  for candidate in docker podman; do
    if tool_available "$candidate"; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  die 'no compatible container runtime found; install Docker, OrbStack, or Podman'
}

runner_id() { printf '%s\n' "symphony-$(project_id "$1")"; }
runner_env_file() { printf '%s/%s.env\n' "$runner_home" "$(project_id "$1")"; }
runner_ssh_config() { printf '%s/%s/ssh_config\n' "$runner_home" "$(project_id "$1")"; }
codex_token_file() { printf '%s/%s/codex_access_token\n' "$secrets_home" "$(project_id "$1")"; }

auth_codex_set() {
  local root=$1 token_file token
  [ "${2:-}" = --from-stdin ] || die 'Usage: symphony auth codex set --from-stdin'
  token=$(cat)
  token=$(printf '%s' "$token" | tr -d '\r\n')
  [ -n "$token" ] || die 'Codex access token is empty'
  root=$(repo_root)
  token_file=$(codex_token_file "$root")
  (umask 077; mkdir -p "$(dirname "$token_file")"; printf '%s\n' "$token" >"$token_file")
  printf 'Codex access token stored: %s\n' "$token_file"
}

auth_codex_remove() {
  local root=$1 token_file
  root=$(repo_root)
  token_file=$(codex_token_file "$root")
  [ -e "$token_file" ] || die "Codex access token is already absent: $token_file"
  rm "$token_file"
  printf 'Codex access token removed: %s\nRestart any runner to revoke its mounted secret.\n' "$token_file"
}

auth_codex_check() {
  local root=$1 token_file runtime name
  root=$(repo_root)
  token_file=$(codex_token_file "$root")
  [ -s "$token_file" ] || die "missing Codex access token: $token_file"
  runner_start "$root"
  runtime=$(container_runtime); name=$(runner_id "$root")
  "$runtime" exec "$name" codex login status
  printf 'Codex access token is available to the isolated runner.\n'
}

auth() {
  local provider=${1:-} action=${2:-}
  [ "$provider" = codex ] || { printf 'Usage: symphony auth codex {set|check|remove}\n' >&2; return 2; }
  shift 2 || true
  case "$action" in
    set) auth_codex_set "$(repo_root)" "$@" ;;
    check) [ "$#" -eq 0 ] || die 'Usage: symphony auth codex check'; auth_codex_check "$(repo_root)" ;;
    remove) [ "$#" -eq 0 ] || die 'Usage: symphony auth codex remove'; auth_codex_remove "$(repo_root)" ;;
    *) printf 'Usage: symphony auth codex {set|check|remove}\n' >&2; return 2 ;;
  esac
}

runner_status() {
  local root=$1 runtime name
  runtime=$(container_runtime); name=$(runner_id "$root")
  "$runtime" inspect --format '{{.State.Running}}' "$name" 2>/dev/null || printf 'missing\n'
}

runner_start() {
  local root=$1 id project_env token_file runtime name state runner_dir key image port env_file ssh_config git_token
  id=$(project_id "$root"); runtime=$(container_runtime); name=$(runner_id "$root")
  runner_dir="$runner_home/$id"; key="$runner_dir/id_ed25519"; env_file="$runner_home/$id.env"
  ssh_config="$runner_dir/ssh_config"; image="${SYMPHONY_RUNNER_IMAGE:-symphony-runner:local}"
  project_env="$config_home/projects/$id.env"
  [ -r "$project_env" ] || die "missing credentials file: $project_env"
  set -a; . "$project_env"; set +a
  token_file=$(codex_token_file "$root")
  git_token=${GH_TOKEN:-${GITHUB_TOKEN:-}}
  [ -s "$token_file" ] || die "missing Codex access token for runner: $token_file (run: symphony auth codex set --from-stdin)"
  [ -n "$git_token" ] || die 'missing GITHUB_TOKEN or GH_TOKEN for the isolated runner'

  state=$(runner_status "$root")
  if [ "$state" = true ]; then
    [ -r "$env_file" ] || die "runner is running but its configuration is missing: $env_file"
    return
  fi
  [ "$state" = missing ] || "$runtime" rm -f "$name" >/dev/null

  mkdir -p "$runner_dir"
  if [ ! -f "$key" ]; then
    ssh-keygen -q -t ed25519 -N '' -f "$key"
  fi

  "$runtime" build -t "$image" "$symphony_home/runner"
  "$runtime" run --detach --rm --name "$name" \
    --publish 127.0.0.1::22 \
    --env "GH_TOKEN=$git_token" \
    --volume "$key.pub:/run/symphony/ssh/authorized_key.pub:ro" \
    --volume "$token_file:/run/secrets/codex_access_token:ro" \
    "$image" >/dev/null
  port=$("$runtime" port "$name" 22/tcp | sed -n '1s/.*://p')
  [ -n "$port" ] || die "unable to determine SSH port for runner: $name"

  umask 077
  cat >"$ssh_config" <<EOF
Host *
  HostName 127.0.0.1
  Port $port
  User root
  IdentityFile $key
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
EOF
  cat >"$env_file" <<EOF
SYMPHONY_ISOLATED_RUNNER=1
SYMPHONY_RUNNER_SSH_HOSTS=127.0.0.1:$port
SYMPHONY_RUNNER_WORKSPACE_ROOT=/workspaces
SYMPHONY_SSH_CONFIG=$ssh_config
EOF
  printf 'Runner: %s (127.0.0.1:%s)\n' "$name" "$port"
}

runner_stop() {
  local root=$1 runtime name
  runtime=$(container_runtime); name=$(runner_id "$root")
  "$runtime" rm -f "$name" >/dev/null 2>&1 || true
  printf 'Runner stopped: %s\n' "$name"
}

runner_doctor() {
  local root=$1 env_file
  runner_start "$root"
  env_file=$(runner_env_file "$root")
  set -a; . "$env_file"; set +a
  # SSH's destination syntax does not accept host:port. The generated config
  # supplies the port and identity, while Symphony itself consumes the
  # host:port value above when it dispatches remote workers.
  ssh -F "$SYMPHONY_SSH_CONFIG" 127.0.0.1 '
    set -eu
    workspace=$(mktemp -d /tmp/symphony-git-preflight.XXXXXX)
    trap "rm -rf \"$workspace\"" EXIT
    git -C "$workspace" init -q
    git -C "$workspace" config user.name Symphony
    git -C "$workspace" config user.email symphony@localhost
    git -C "$workspace" switch -q -c preflight
    printf ready > "$workspace/READY"
    git -C "$workspace" add READY
    git -C "$workspace" commit -qm preflight
  '
  printf 'Runner Git preflight passed.\n'
}

runner() {
  local command=${1:-} root
  root=$(repo_root)
  case "$command" in
    start) runner_start "$root" ;;
    stop) runner_stop "$root" ;;
    status) printf 'Runner: %s\n' "$(runner_status "$root")" ;;
    doctor) runner_doctor "$root" ;;
    --help|-h|'') printf 'Usage: symphony runner start|stop|status|doctor\n' ;;
    *) die "unknown runner command: $command" ;;
  esac
}

run() {
  local root id env_file workflow runtime isolated=false
  if [ "${1:-}" = --isolated ]; then isolated=true; shift; fi
  root=$(repo_root); id=$(project_id "$root")
  env_file="$config_home/projects/$id.env"; workflow="$root/WORKFLOW.md"
  [ -r "$env_file" ] || die "missing credentials file: $env_file"
  [ -f "$workflow" ] || die "missing workflow: $workflow"
  runtime_ready || die 'Symphony runtime is not ready; run symphony setup'
  set -a; . "$env_file"; set +a
  if "$isolated"; then
    runner_start "$root"
    set -a; . "$(runner_env_file "$root")"; set +a
  fi
  runtime="$symphony_home/elixir/bin/symphony"
  exec mise exec -C "$symphony_home/elixir" -- "$runtime" \
    --i-understand-that-this-will-be-running-without-the-usual-guardrails "$workflow" "$@"
}

case "${1:-}" in
  --version) printf '{"mode":"cli","source_revision":"%s","source_state":"%s"}\n' "$(source_revision)" "$(source_state)" ;;
  --help|-h|'') usage ;;
  install) shift; install "$@" ;;
  setup) shift; setup "$@" ;;
  doctor) shift; doctor "$@" ;;
  update) shift; update "$@" ;;
  init) shift; init "$@" ;;
  skill) shift; skill "$@" ;;
  project) shift; project "$@" ;;
  auth) shift; auth "$@" ;;
  runner) shift; runner "$@" ;;
  run) shift; run "$@" ;;
  *) usage >&2; exit 2 ;;
esac
