#!/usr/bin/env bash
# Development lab only. Never calls the global Symphony launcher or updater.
set -euo pipefail
lab_root=$(cd "$(dirname "$0")" && pwd)
lab_namespace=symphony-claude-qualification-01a15554
lab_auth="$lab_namespace-auth"
lab_workspace="$lab_namespace-workspace"
lab_label=com.symphony.claude-qualification

fail() { printf '%s\n' "$1" >&2; exit 1; }

owned_volume() {
  local volume=$1 owner
  if docker volume inspect "$volume" >/dev/null 2>&1; then
    owner=$(docker volume inspect --format "{{index .Labels \"$lab_label\"}}" "$volume")
    [ "$owner" = "$lab_namespace" ] || fail "Refusing foreign lab volume: $volume"
  else
    docker volume create --label "$lab_label=$lab_namespace" "$volume" >/dev/null
  fi
}

build_image() {
  # Docker owns the input graph/cache; never qualify a stale mutable tag.
  lab_image=$(docker build --quiet --file "$lab_root/Dockerfile" \
    --label "$lab_label=$lab_namespace" --tag "$lab_namespace:runtime" "$lab_root/..")
  [ -n "$lab_image" ] || fail 'Docker build returned no image identity.'
}

verify_image() {
  local owner
  build_image
  owner=$(docker image inspect --format "{{index .Config.Labels \"$lab_label\"}}" "$lab_image")
  [ "$owner" = "$lab_namespace" ] || fail 'Qualification image identity mismatch; run lab build.'
  # build --quiet returned the immutable ID; inspect and execute that same ID.
}

usage() {
  printf 'Usage: %s build|test|inspect|login|status|live|cancel\n' "$0"
  printf 'Isolated development resources. live sends two model turns; cancel sends one.\n'
}

command=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
case "$command" in
  build)
    [ "$#" = 0 ] || fail 'build takes no arguments'
    build_image
    printf 'Qualification image: %s\n' "$lab_image"
    ;;
  test)
    [ "$#" = 0 ] || fail 'test takes no arguments'
    verify_image
    docker run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges \
      --tmpfs /tmp:rw,exec,nosuid,nodev,size=32m \
      --entrypoint sh --workdir /opt/symphony-claude-lab/qualification "$lab_image" -c 'node --test test/*.test.mjs'
    ;;
  inspect|login|status|live|cancel)
    [ "$#" = 0 ] || fail "$command takes no arguments"
    verify_image
    owned_volume "$lab_auth"
    owned_volume "$lab_workspace"
    flags=(--network bridge)
    [ "$command" != inspect ] || flags=(--network none)
    [ "$command" != login ] || flags+=(-it)
    docker run --rm --name "$lab_namespace-active" "${flags[@]}" \
      --label "$lab_label=$lab_namespace" \
      --read-only --cap-drop ALL --security-opt no-new-privileges \
      --pids-limit 256 --memory 2g --tmpfs /tmp:rw,nosuid,nodev,size=128m \
      --mount "type=volume,source=$lab_auth,target=/home/claude" \
      --mount "type=volume,source=$lab_workspace,target=/lab-workspace" \
      "$lab_image" "$command" "$@"
    ;;
  help|--help|-h) usage ;;
  *) usage >&2; exit 1 ;;
esac
